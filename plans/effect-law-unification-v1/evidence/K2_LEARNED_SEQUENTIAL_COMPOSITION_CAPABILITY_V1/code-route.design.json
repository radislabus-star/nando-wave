{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id":"experiment_driver","role":"interface"},
    {"id":"support_observations","role":"producer"},
    {"id":"support_evidence_store","role":"evidence_owner"},
    {"id":"effect_learner_process","role":"candidate_rank_owner"},
    {"id":"learned_law_bytes","role":"producer"},
    {"id":"planning_input_store","role":"evidence_owner"},
    {"id":"composition_planner_process","role":"candidate_rank_owner"},
    {"id":"planner_output","role":"producer"},
    {"id":"independent_plan_verifier","role":"proof_owner"},
    {"id":"verified_plan_bytes","role":"producer"},
    {"id":"verified_plan_store","role":"evidence_owner"},
    {"id":"private_mapping_resolver","role":"authorization_owner"},
    {"id":"sequential_sandbox_adapter","role":"orchestrator"},
    {"id":"sequential_worker","role":"mutation_owner"},
    {"id":"worker_filesystem_state","role":"producer"},
    {"id":"filesystem_observer","role":"observer"},
    {"id":"adapter_terminal_manifest","role":"producer"},
    {"id":"exact_goal_oracle","role":"proof_owner"},
    {"id":"journal_event_bytes","role":"producer"},
    {"id":"composition_journal","role":"evidence_owner"},
    {"id":"cleanup_owner","role":"mutation_owner"}
  ],
  "edges": [
    {"id":"exec-driver-learner","from":"experiment_driver","relation":"calls","to":"effect_learner_process","events":["learn_effects"]},
    {"id":"authority-support-store","from":"support_observations","relation":"produces_for","to":"support_evidence_store","events":["learn_effects"]},
    {"id":"authority-store-learner","from":"support_evidence_store","relation":"passes_to","to":"effect_learner_process","events":["learn_effects"]},

    {"id":"exec-driver-planner","from":"experiment_driver","relation":"calls","to":"composition_planner_process","events":["plan_composition"]},
    {"id":"authority-laws-planning-store","from":"learned_law_bytes","relation":"produces_for","to":"planning_input_store","events":["plan_composition"]},
    {"id":"authority-planning-store-planner","from":"planning_input_store","relation":"passes_to","to":"composition_planner_process","events":["plan_composition"]},

    {"id":"exec-driver-plan-verifier","from":"experiment_driver","relation":"calls","to":"independent_plan_verifier","events":["verify_plan"]},
    {"id":"proof-planner-verifier","from":"planner_output","relation":"proves","to":"independent_plan_verifier","events":["verify_plan"]},

    {"id":"exec-driver-resolver","from":"experiment_driver","relation":"calls","to":"private_mapping_resolver","events":["execute_target"]},
    {"id":"exec-resolver-adapter","from":"private_mapping_resolver","relation":"delegates","to":"sequential_sandbox_adapter","events":["execute_target"]},
    {"id":"exec-adapter-worker","from":"sequential_sandbox_adapter","relation":"calls","to":"sequential_worker","events":["execute_target"]},
    {"id":"authority-plan-store","from":"verified_plan_bytes","relation":"produces_for","to":"verified_plan_store","events":["execute_target"]},
    {"id":"authority-plan-resolver","from":"verified_plan_store","relation":"passes_to","to":"private_mapping_resolver","events":["execute_target"]},
    {"id":"authority-resolver-worker","from":"private_mapping_resolver","relation":"authorizes","to":"sequential_worker","events":["execute_target"]},

    {"id":"exec-driver-observer","from":"experiment_driver","relation":"calls","to":"filesystem_observer","events":["observe_target"]},
    {"id":"observe-worker-filesystem","from":"worker_filesystem_state","relation":"observes","to":"filesystem_observer","events":["observe_target"]},

    {"id":"exec-driver-oracle","from":"experiment_driver","relation":"calls","to":"exact_goal_oracle","events":["verify_goal"]},
    {"id":"proof-manifest-oracle","from":"adapter_terminal_manifest","relation":"proves","to":"exact_goal_oracle","events":["verify_goal"]},

    {"id":"exec-driver-journal","from":"experiment_driver","relation":"calls","to":"composition_journal","events":["persist_event"]},
    {"id":"authority-event-journal","from":"journal_event_bytes","relation":"produces_for","to":"composition_journal","events":["persist_event"]},

    {"id":"exec-driver-cleanup","from":"experiment_driver","relation":"calls","to":"cleanup_owner","events":["cleanup_generated"]}
  ],
  "routes": [
    {"id":"learner-execution","event":"learn_effects","kind":"execution","entry":"experiment_driver","terminal":"effect_learner_process","required_roles":["interface","candidate_rank_owner"],"path_cardinality":[{"from":"experiment_driver","to":"effect_learner_process","min":1,"max":1}]},
    {"id":"learner-authority","event":"learn_effects","kind":"authority","entry":"support_observations","terminal":"effect_learner_process","required_roles":["producer","evidence_owner","candidate_rank_owner"],"path_cardinality":[{"from":"support_observations","to":"effect_learner_process","min":1,"max":1}]},

    {"id":"planner-execution","event":"plan_composition","kind":"execution","entry":"experiment_driver","terminal":"composition_planner_process","required_roles":["interface","candidate_rank_owner"],"path_cardinality":[{"from":"experiment_driver","to":"composition_planner_process","min":1,"max":1}]},
    {"id":"planner-authority","event":"plan_composition","kind":"authority","entry":"learned_law_bytes","terminal":"composition_planner_process","required_roles":["producer","evidence_owner","candidate_rank_owner"],"path_cardinality":[{"from":"learned_law_bytes","to":"composition_planner_process","min":1,"max":1}]},

    {"id":"plan-verifier-execution","event":"verify_plan","kind":"execution","entry":"experiment_driver","terminal":"independent_plan_verifier","required_roles":["interface","proof_owner"],"path_cardinality":[{"from":"experiment_driver","to":"independent_plan_verifier","min":1,"max":1}]},
    {"id":"plan-proof","event":"verify_plan","kind":"proof","entry":"planner_output","terminal":"independent_plan_verifier","required_roles":["producer","proof_owner"],"path_cardinality":[{"from":"planner_output","to":"independent_plan_verifier","min":1,"max":1}]},

    {"id":"target-execution","event":"execute_target","kind":"execution","entry":"experiment_driver","terminal":"sequential_worker","required_roles":["interface","authorization_owner","orchestrator","mutation_owner"],"path_cardinality":[{"from":"experiment_driver","to":"sequential_worker","min":1,"max":1}]},
    {"id":"target-authority","event":"execute_target","kind":"authority","entry":"verified_plan_bytes","terminal":"sequential_worker","required_roles":["producer","evidence_owner","authorization_owner","mutation_owner"],"path_cardinality":[{"from":"verified_plan_bytes","to":"sequential_worker","min":1,"max":1}]},

    {"id":"target-observer-execution","event":"observe_target","kind":"execution","entry":"experiment_driver","terminal":"filesystem_observer","required_roles":["interface","observer"],"path_cardinality":[{"from":"experiment_driver","to":"filesystem_observer","min":1,"max":1}]},
    {"id":"target-observation","event":"observe_target","kind":"observation","entry":"worker_filesystem_state","terminal":"filesystem_observer","required_roles":["producer","observer"],"path_cardinality":[{"from":"worker_filesystem_state","to":"filesystem_observer","min":1,"max":1}]},

    {"id":"oracle-execution","event":"verify_goal","kind":"execution","entry":"experiment_driver","terminal":"exact_goal_oracle","required_roles":["interface","proof_owner"],"path_cardinality":[{"from":"experiment_driver","to":"exact_goal_oracle","min":1,"max":1}]},
    {"id":"oracle-proof","event":"verify_goal","kind":"proof","entry":"adapter_terminal_manifest","terminal":"exact_goal_oracle","required_roles":["producer","proof_owner"],"path_cardinality":[{"from":"adapter_terminal_manifest","to":"exact_goal_oracle","min":1,"max":1}]},

    {"id":"journal-execution","event":"persist_event","kind":"execution","entry":"experiment_driver","terminal":"composition_journal","required_roles":["interface","evidence_owner"],"path_cardinality":[{"from":"experiment_driver","to":"composition_journal","min":1,"max":1}]},
    {"id":"journal-authority","event":"persist_event","kind":"authority","entry":"journal_event_bytes","terminal":"composition_journal","required_roles":["producer","evidence_owner"],"path_cardinality":[{"from":"journal_event_bytes","to":"composition_journal","min":1,"max":1}]},

    {"id":"cleanup-execution","event":"cleanup_generated","kind":"execution","entry":"experiment_driver","terminal":"cleanup_owner","required_roles":["interface","mutation_owner"],"path_cardinality":[{"from":"experiment_driver","to":"cleanup_owner","min":1,"max":1}]}
  ]
}
