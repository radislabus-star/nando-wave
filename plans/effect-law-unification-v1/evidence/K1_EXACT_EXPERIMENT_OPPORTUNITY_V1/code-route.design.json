  "routes": [
    {"id":"learner-proposal-execution","event":"learner_proposal","kind":"execution","entry":"cold_wake","terminal":"cold_manifest_builder","required_roles":["interface","producer","evidence_owner"],"path_cardinality":[{"from":"cold_wake","to":"cold_manifest_builder","min":1,"max":1}]},
    {"id":"learner-proposal-authority-free-ranking","event":"learner_proposal","kind":"authority","entry":"cold_source_restore","terminal":"cold_queue_builder","required_roles":["producer","evidence_owner","candidate_rank_owner"]},
    {"id":"freeze-authority","event":"freeze_authorization","kind":"authority","entry":"freeze_request","terminal":"signed_journal_append","required_roles":["interface","evidence_owner","producer","candidate_rank_owner","authorization_owner","mutation_owner"],"path_cardinality":[{"from":"freeze_request","to":"signed_journal_append","min":1,"max":1}]},
    {"id":"identifier-execution","event":"identifier_run","kind":"execution","entry":"active_freeze","terminal":"identifier_evaluator","required_roles":["interface","evidence_owner","producer"],"path_cardinality":[{"from":"active_freeze","to":"identifier_evaluator","min":1,"max":1}]},
    {"id":"terminal-authority","event":"terminal_authorization","kind":"authority","entry":"terminal_request","terminal":"signed_journal_append","required_roles":["interface","evidence_owner","producer","authorization_owner","mutation_owner"],"path_cardinality":[{"from":"terminal_request","to":"signed_journal_append","min":1,"max":1}]},
