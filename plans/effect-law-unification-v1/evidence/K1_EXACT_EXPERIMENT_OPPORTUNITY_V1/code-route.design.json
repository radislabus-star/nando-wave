    {"id":"authority_source_restore","role":"producer"},
    {"id":"authority_manifest_builder","role":"evidence_owner"},
    {"id":"authority_queue_builder","role":"candidate_rank_owner"},
    {"id":"freeze_authorizer","role":"authorization_owner"},
    {"id":"signed_journal_append","role":"mutation_owner"},
