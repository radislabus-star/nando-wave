    {"id":"auth-freeze-restore","from":"freeze_request","relation":"passes_to","to":"authority_source_restore","events":["freeze_authorization"]},
    {"id":"auth-freeze-manifest","from":"authority_source_restore","relation":"produces_for","to":"authority_manifest_builder","events":["freeze_authorization"]},
    {"id":"auth-freeze-rank","from":"authority_manifest_builder","relation":"passes_to","to":"authority_queue_builder","events":["freeze_authorization"]},
    {"id":"auth-freeze-authorize","from":"authority_queue_builder","relation":"passes_to","to":"freeze_authorizer","events":["freeze_authorization"]},
    {"id":"auth-freeze-append","from":"freeze_authorizer","relation":"authorizes","to":"signed_journal_append","events":["freeze_authorization"]},

