    {"id":"auth-terminal-append","from":"terminal_authorizer","relation":"authorizes","to":"signed_journal_append","events":["terminal_authorization"]},

    {"id":"proof-attempt","from":"attempt_projection","relation":"proves","to":"attempt_parity_test","events":["restart_parity"]},
    {"id":"observe-summary","from":"summary_projection","relation":"observes","to":"control_observer","events":["dashboard_refresh"]}
