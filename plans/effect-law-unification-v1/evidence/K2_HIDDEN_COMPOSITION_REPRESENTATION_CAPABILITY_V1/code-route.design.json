{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "experiment_driver", "role": "interface"},
    {"id": "train_task_bytes", "role": "producer"},
    {"id": "train_task_store", "role": "evidence_owner"},
    {"id": "train_baseline", "role": "candidate_rank_owner"},
    {"id": "train_feature_rows", "role": "producer"},
    {"id": "train_corpus_store", "role": "evidence_owner"},
    {"id": "trainer_process", "role": "candidate_rank_owner"},
    {"id": "model_bytes", "role": "producer"},
    {"id": "model_store", "role": "evidence_owner"},
    {"id": "confirm_task_bytes", "role": "producer"},
    {"id": "confirm_task_store", "role": "evidence_owner"},
    {"id": "confirm_baseline", "role": "candidate_rank_owner"},
    {"id": "confirm_baseline_output", "role": "producer"},
    {"id": "policy_input_store", "role": "evidence_owner"},
    {"id": "hidden_policy", "role": "candidate_rank_owner"},
    {"id": "policy_output", "role": "producer"},
    {"id": "independent_verifier", "role": "proof_owner"},
    {"id": "verified_policy_bytes", "role": "producer"},
    {"id": "verified_policy_store", "role": "evidence_owner"},
    {"id": "execution_dispatch", "role": "authorization_owner"},
    {"id": "sandbox_adapter", "role": "orchestrator"},
    {"id": "sandbox_worker", "role": "mutation_owner"},
    {"id": "worker_filesystem_state", "role": "producer"},
    {"id": "filesystem_observer", "role": "observer"},
    {"id": "adapter_manifest", "role": "producer"},
    {"id": "exact_oracle", "role": "proof_owner"},
    {"id": "journal_event_bytes", "role": "producer"},
    {"id": "representation_journal", "role": "evidence_owner"},
    {"id": "cleanup_owner", "role": "mutation_owner"}
  ],
  "edges": [
    {"id": "exec-driver-train-baseline", "from": "experiment_driver", "relation": "calls", "to": "train_baseline", "events": ["build_train_corpus"]},
    {"id": "authority-train-task-store", "from": "train_task_bytes", "relation": "produces_for", "to": "train_task_store", "events": ["build_train_corpus"]},
    {"id": "authority-train-store-baseline", "from": "train_task_store", "relation": "passes_to", "to": "train_baseline", "events": ["build_train_corpus"]},

    {"id": "exec-driver-trainer", "from": "experiment_driver", "relation": "calls", "to": "trainer_process", "events": ["train_model"]},
    {"id": "authority-feature-corpus", "from": "train_feature_rows", "relation": "produces_for", "to": "train_corpus_store", "events": ["train_model"]},
    {"id": "authority-corpus-trainer", "from": "train_corpus_store", "relation": "passes_to", "to": "trainer_process", "events": ["train_model"]},
    {"id": "authority-model-store", "from": "model_bytes", "relation": "produces_for", "to": "model_store", "events": ["publish_model"]},

    {"id": "exec-driver-confirm-baseline", "from": "experiment_driver", "relation": "calls", "to": "confirm_baseline", "events": ["confirm_baseline"]},
    {"id": "authority-confirm-task-store", "from": "confirm_task_bytes", "relation": "produces_for", "to": "confirm_task_store", "events": ["confirm_baseline"]},
    {"id": "authority-confirm-store-baseline", "from": "confirm_task_store", "relation": "passes_to", "to": "confirm_baseline", "events": ["confirm_baseline"]},

    {"id": "exec-driver-policy", "from": "experiment_driver", "relation": "calls", "to": "hidden_policy", "events": ["run_policy"]},
    {"id": "authority-model-policy-store", "from": "model_bytes", "relation": "produces_for", "to": "policy_input_store", "events": ["run_policy"]},
    {"id": "authority-policy-store-policy", "from": "policy_input_store", "relation": "passes_to", "to": "hidden_policy", "events": ["run_policy"]},

    {"id": "exec-driver-verifier", "from": "experiment_driver", "relation": "calls", "to": "independent_verifier", "events": ["verify_policy"]},
    {"id": "proof-policy-verifier", "from": "policy_output", "relation": "proves", "to": "independent_verifier", "events": ["verify_policy"]},
    {"id": "proof-baseline-verifier", "from": "confirm_baseline_output", "relation": "proves", "to": "independent_verifier", "events": ["verify_policy"]},

    {"id": "exec-driver-dispatch", "from": "experiment_driver", "relation": "calls", "to": "execution_dispatch", "events": ["execute_confirm"]},
    {"id": "exec-dispatch-adapter", "from": "execution_dispatch", "relation": "delegates", "to": "sandbox_adapter", "events": ["execute_confirm"]},
    {"id": "exec-adapter-worker", "from": "sandbox_adapter", "relation": "calls", "to": "sandbox_worker", "events": ["execute_confirm"]},
    {"id": "authority-verified-store", "from": "verified_policy_bytes", "relation": "produces_for", "to": "verified_policy_store", "events": ["execute_confirm"]},
    {"id": "authority-store-dispatch", "from": "verified_policy_store", "relation": "passes_to", "to": "execution_dispatch", "events": ["execute_confirm"]},
    {"id": "authority-dispatch-worker", "from": "execution_dispatch", "relation": "authorizes", "to": "sandbox_worker", "events": ["execute_confirm"]},

    {"id": "exec-driver-observer", "from": "experiment_driver", "relation": "calls", "to": "filesystem_observer", "events": ["observe_confirm"]},
    {"id": "observe-worker-state", "from": "worker_filesystem_state", "relation": "observes", "to": "filesystem_observer", "events": ["observe_confirm"]},

    {"id": "exec-driver-oracle", "from": "experiment_driver", "relation": "calls", "to": "exact_oracle", "events": ["verify_goal"]},
    {"id": "proof-manifest-oracle", "from": "adapter_manifest", "relation": "proves", "to": "exact_oracle", "events": ["verify_goal"]},

    {"id": "exec-driver-journal", "from": "experiment_driver", "relation": "calls", "to": "representation_journal", "events": ["persist_event"]},
    {"id": "authority-event-journal", "from": "journal_event_bytes", "relation": "produces_for", "to": "representation_journal", "events": ["persist_event"]},
    {"id": "exec-driver-cleanup", "from": "experiment_driver", "relation": "calls", "to": "cleanup_owner", "events": ["cleanup_generated"]}
  ],
  "routes": [
    {"id": "train-baseline-execution", "event": "build_train_corpus", "kind": "execution", "entry": "experiment_driver", "terminal": "train_baseline", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "train_baseline", "min": 1, "max": 1}]},
    {"id": "train-baseline-authority", "event": "build_train_corpus", "kind": "authority", "entry": "train_task_bytes", "terminal": "train_baseline", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "train_task_bytes", "to": "train_baseline", "min": 1, "max": 1}]},
    {"id": "trainer-execution", "event": "train_model", "kind": "execution", "entry": "experiment_driver", "terminal": "trainer_process", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "trainer_process", "min": 1, "max": 1}]},
    {"id": "trainer-authority", "event": "train_model", "kind": "authority", "entry": "train_feature_rows", "terminal": "trainer_process", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "train_feature_rows", "to": "trainer_process", "min": 1, "max": 1}]},
    {"id": "model-publish-authority", "event": "publish_model", "kind": "authority", "entry": "model_bytes", "terminal": "model_store", "required_roles": ["producer", "evidence_owner"], "path_cardinality": [{"from": "model_bytes", "to": "model_store", "min": 1, "max": 1}]},
    {"id": "confirm-baseline-execution", "event": "confirm_baseline", "kind": "execution", "entry": "experiment_driver", "terminal": "confirm_baseline", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "confirm_baseline", "min": 1, "max": 1}]},
    {"id": "confirm-baseline-authority", "event": "confirm_baseline", "kind": "authority", "entry": "confirm_task_bytes", "terminal": "confirm_baseline", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "confirm_task_bytes", "to": "confirm_baseline", "min": 1, "max": 1}]},
    {"id": "policy-execution", "event": "run_policy", "kind": "execution", "entry": "experiment_driver", "terminal": "hidden_policy", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "hidden_policy", "min": 1, "max": 1}]},
    {"id": "policy-authority", "event": "run_policy", "kind": "authority", "entry": "model_bytes", "terminal": "hidden_policy", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "model_bytes", "to": "hidden_policy", "min": 1, "max": 1}]},
    {"id": "verifier-execution", "event": "verify_policy", "kind": "execution", "entry": "experiment_driver", "terminal": "independent_verifier", "required_roles": ["interface", "proof_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "independent_verifier", "min": 1, "max": 1}]},
    {"id": "policy-proof", "event": "verify_policy", "kind": "proof", "entry": "policy_output", "terminal": "independent_verifier", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "policy_output", "to": "independent_verifier", "min": 1, "max": 1}]},
    {"id": "baseline-proof", "event": "verify_policy", "kind": "proof", "entry": "confirm_baseline_output", "terminal": "independent_verifier", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "confirm_baseline_output", "to": "independent_verifier", "min": 1, "max": 1}]},
    {"id": "confirm-execution", "event": "execute_confirm", "kind": "execution", "entry": "experiment_driver", "terminal": "sandbox_worker", "required_roles": ["interface", "authorization_owner", "orchestrator", "mutation_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "sandbox_worker", "min": 1, "max": 1}]},
    {"id": "confirm-authority", "event": "execute_confirm", "kind": "authority", "entry": "verified_policy_bytes", "terminal": "sandbox_worker", "required_roles": ["producer", "evidence_owner", "authorization_owner", "mutation_owner"], "path_cardinality": [{"from": "verified_policy_bytes", "to": "sandbox_worker", "min": 1, "max": 1}]},
    {"id": "observer-execution", "event": "observe_confirm", "kind": "execution", "entry": "experiment_driver", "terminal": "filesystem_observer", "required_roles": ["interface", "observer"], "path_cardinality": [{"from": "experiment_driver", "to": "filesystem_observer", "min": 1, "max": 1}]},
    {"id": "confirm-observation", "event": "observe_confirm", "kind": "observation", "entry": "worker_filesystem_state", "terminal": "filesystem_observer", "required_roles": ["producer", "observer"], "path_cardinality": [{"from": "worker_filesystem_state", "to": "filesystem_observer", "min": 1, "max": 1}]},
    {"id": "oracle-execution", "event": "verify_goal", "kind": "execution", "entry": "experiment_driver", "terminal": "exact_oracle", "required_roles": ["interface", "proof_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "exact_oracle", "min": 1, "max": 1}]},
    {"id": "oracle-proof", "event": "verify_goal", "kind": "proof", "entry": "adapter_manifest", "terminal": "exact_oracle", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "adapter_manifest", "to": "exact_oracle", "min": 1, "max": 1}]},
    {"id": "journal-execution", "event": "persist_event", "kind": "execution", "entry": "experiment_driver", "terminal": "representation_journal", "required_roles": ["interface", "evidence_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "representation_journal", "min": 1, "max": 1}]},
    {"id": "journal-authority", "event": "persist_event", "kind": "authority", "entry": "journal_event_bytes", "terminal": "representation_journal", "required_roles": ["producer", "evidence_owner"], "path_cardinality": [{"from": "journal_event_bytes", "to": "representation_journal", "min": 1, "max": 1}]},
    {"id": "cleanup-execution", "event": "cleanup_generated", "kind": "execution", "entry": "experiment_driver", "terminal": "cleanup_owner", "required_roles": ["interface", "mutation_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "cleanup_owner", "min": 1, "max": 1}]}
  ]
}
