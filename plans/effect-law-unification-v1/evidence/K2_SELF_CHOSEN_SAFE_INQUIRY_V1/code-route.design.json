{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "experiment_driver", "role": "interface"},
    {"id": "public_case_bytes", "role": "producer"},
    {"id": "public_case_store", "role": "evidence_owner"},
    {"id": "baseline_process", "role": "candidate_rank_owner"},
    {"id": "selector_process", "role": "candidate_rank_owner"},
    {"id": "selection_precommit", "role": "producer"},
    {"id": "preexecution_verifier", "role": "proof_owner"},
    {"id": "verified_selection_store", "role": "evidence_owner"},
    {"id": "dispatch_owner", "role": "authorization_owner"},
    {"id": "sandbox_adapter", "role": "orchestrator"},
    {"id": "sandbox_worker", "role": "mutation_owner"},
    {"id": "workspace_state", "role": "producer"},
    {"id": "observer_process", "role": "observer"},
    {"id": "observation_receipt", "role": "producer"},
    {"id": "elimination_verifier", "role": "proof_owner"},
    {"id": "journal_event_bytes", "role": "producer"},
    {"id": "inquiry_journal", "role": "evidence_owner"},
    {"id": "cleanup_owner", "role": "mutation_owner"}
  ],
  "edges": [
    {"id": "exec-driver-baseline", "from": "experiment_driver", "relation": "calls", "to": "baseline_process", "events": ["evaluate_baselines"]},
    {"id": "authority-case-store-baseline", "from": "public_case_bytes", "relation": "produces_for", "to": "public_case_store", "events": ["evaluate_baselines"]},
    {"id": "authority-store-baseline", "from": "public_case_store", "relation": "passes_to", "to": "baseline_process", "events": ["evaluate_baselines"]},

    {"id": "exec-driver-selector", "from": "experiment_driver", "relation": "calls", "to": "selector_process", "events": ["select_probe"]},
    {"id": "authority-case-store-selector", "from": "public_case_bytes", "relation": "produces_for", "to": "public_case_store", "events": ["select_probe"]},
    {"id": "authority-store-selector", "from": "public_case_store", "relation": "passes_to", "to": "selector_process", "events": ["select_probe"]},

    {"id": "exec-driver-preverify", "from": "experiment_driver", "relation": "calls", "to": "preexecution_verifier", "events": ["verify_selection"]},
    {"id": "proof-precommit-preverify", "from": "selection_precommit", "relation": "proves", "to": "preexecution_verifier", "events": ["verify_selection"]},
    {"id": "authority-verified-selection", "from": "selection_precommit", "relation": "produces_for", "to": "verified_selection_store", "events": ["publish_verified_selection"]},

    {"id": "exec-driver-dispatch", "from": "experiment_driver", "relation": "calls", "to": "dispatch_owner", "events": ["execute_probe"]},
    {"id": "exec-dispatch-adapter", "from": "dispatch_owner", "relation": "delegates", "to": "sandbox_adapter", "events": ["execute_probe"]},
    {"id": "exec-adapter-worker", "from": "sandbox_adapter", "relation": "calls", "to": "sandbox_worker", "events": ["execute_probe"]},
    {"id": "authority-store-dispatch", "from": "verified_selection_store", "relation": "passes_to", "to": "dispatch_owner", "events": ["execute_probe"]},
    {"id": "authority-dispatch-worker", "from": "dispatch_owner", "relation": "authorizes", "to": "sandbox_worker", "events": ["execute_probe"]},

    {"id": "exec-driver-observer", "from": "experiment_driver", "relation": "calls", "to": "observer_process", "events": ["observe_probe"]},
    {"id": "observe-workspace-observer", "from": "workspace_state", "relation": "observes", "to": "observer_process", "events": ["observe_probe"]},

    {"id": "exec-driver-elimination", "from": "experiment_driver", "relation": "calls", "to": "elimination_verifier", "events": ["eliminate_models"]},
    {"id": "proof-precommit-elimination", "from": "selection_precommit", "relation": "proves", "to": "elimination_verifier", "events": ["eliminate_models"]},
    {"id": "proof-observation-elimination", "from": "observation_receipt", "relation": "proves", "to": "elimination_verifier", "events": ["eliminate_models"]},

    {"id": "exec-driver-journal", "from": "experiment_driver", "relation": "calls", "to": "inquiry_journal", "events": ["persist_event"]},
    {"id": "authority-event-journal", "from": "journal_event_bytes", "relation": "produces_for", "to": "inquiry_journal", "events": ["persist_event"]},
    {"id": "exec-driver-cleanup", "from": "experiment_driver", "relation": "calls", "to": "cleanup_owner", "events": ["cleanup_generated"]}
  ],
  "routes": [
    {"id": "baseline-execution", "event": "evaluate_baselines", "kind": "execution", "entry": "experiment_driver", "terminal": "baseline_process", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "baseline_process", "min": 1, "max": 1}]},
    {"id": "baseline-authority", "event": "evaluate_baselines", "kind": "authority", "entry": "public_case_bytes", "terminal": "baseline_process", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "public_case_bytes", "to": "baseline_process", "min": 1, "max": 1}]},
    {"id": "selector-execution", "event": "select_probe", "kind": "execution", "entry": "experiment_driver", "terminal": "selector_process", "required_roles": ["interface", "candidate_rank_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "selector_process", "min": 1, "max": 1}]},
    {"id": "selector-authority", "event": "select_probe", "kind": "authority", "entry": "public_case_bytes", "terminal": "selector_process", "required_roles": ["producer", "evidence_owner", "candidate_rank_owner"], "path_cardinality": [{"from": "public_case_bytes", "to": "selector_process", "min": 1, "max": 1}]},
    {"id": "preverify-execution", "event": "verify_selection", "kind": "execution", "entry": "experiment_driver", "terminal": "preexecution_verifier", "required_roles": ["interface", "proof_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "preexecution_verifier", "min": 1, "max": 1}]},
    {"id": "selection-proof", "event": "verify_selection", "kind": "proof", "entry": "selection_precommit", "terminal": "preexecution_verifier", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "selection_precommit", "to": "preexecution_verifier", "min": 1, "max": 1}]},
    {"id": "selection-authority", "event": "publish_verified_selection", "kind": "authority", "entry": "selection_precommit", "terminal": "verified_selection_store", "required_roles": ["producer", "evidence_owner"], "path_cardinality": [{"from": "selection_precommit", "to": "verified_selection_store", "min": 1, "max": 1}]},
    {"id": "probe-execution", "event": "execute_probe", "kind": "execution", "entry": "experiment_driver", "terminal": "sandbox_worker", "required_roles": ["interface", "authorization_owner", "orchestrator", "mutation_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "sandbox_worker", "min": 1, "max": 1}]},
    {"id": "probe-authority", "event": "execute_probe", "kind": "authority", "entry": "verified_selection_store", "terminal": "sandbox_worker", "required_roles": ["evidence_owner", "authorization_owner", "mutation_owner"], "path_cardinality": [{"from": "verified_selection_store", "to": "sandbox_worker", "min": 1, "max": 1}]},
    {"id": "observer-execution", "event": "observe_probe", "kind": "execution", "entry": "experiment_driver", "terminal": "observer_process", "required_roles": ["interface", "observer"], "path_cardinality": [{"from": "experiment_driver", "to": "observer_process", "min": 1, "max": 1}]},
    {"id": "probe-observation", "event": "observe_probe", "kind": "observation", "entry": "workspace_state", "terminal": "observer_process", "required_roles": ["producer", "observer"], "path_cardinality": [{"from": "workspace_state", "to": "observer_process", "min": 1, "max": 1}]},
    {"id": "elimination-execution", "event": "eliminate_models", "kind": "execution", "entry": "experiment_driver", "terminal": "elimination_verifier", "required_roles": ["interface", "proof_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "elimination_verifier", "min": 1, "max": 1}]},
    {"id": "elimination-selection-proof", "event": "eliminate_models", "kind": "proof", "entry": "selection_precommit", "terminal": "elimination_verifier", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "selection_precommit", "to": "elimination_verifier", "min": 1, "max": 1}]},
    {"id": "elimination-observation-proof", "event": "eliminate_models", "kind": "proof", "entry": "observation_receipt", "terminal": "elimination_verifier", "required_roles": ["producer", "proof_owner"], "path_cardinality": [{"from": "observation_receipt", "to": "elimination_verifier", "min": 1, "max": 1}]},
    {"id": "journal-execution", "event": "persist_event", "kind": "execution", "entry": "experiment_driver", "terminal": "inquiry_journal", "required_roles": ["interface", "evidence_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "inquiry_journal", "min": 1, "max": 1}]},
    {"id": "journal-authority", "event": "persist_event", "kind": "authority", "entry": "journal_event_bytes", "terminal": "inquiry_journal", "required_roles": ["producer", "evidence_owner"], "path_cardinality": [{"from": "journal_event_bytes", "to": "inquiry_journal", "min": 1, "max": 1}]},
    {"id": "cleanup-execution", "event": "cleanup_generated", "kind": "execution", "entry": "experiment_driver", "terminal": "cleanup_owner", "required_roles": ["interface", "mutation_owner"], "path_cardinality": [{"from": "experiment_driver", "to": "cleanup_owner", "min": 1, "max": 1}]}
  ]
}
