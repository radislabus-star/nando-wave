{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id": "authorization_input", "role": "interface"},
    {"id": "authorization_slot_owner", "role": "authorization_owner"},
    {"id": "slot_ledger", "role": "mutation_owner"},
    {"id": "confirm_owner", "role": "orchestrator"},
    {"id": "generator", "role": "producer"},
    {"id": "public_batch", "role": "evidence_owner"},
    {"id": "public_coordinator", "role": "orchestrator"},
    {"id": "learner", "role": "producer"},
    {"id": "model_sets", "role": "evidence_owner"},
    {"id": "probe_enumerator", "role": "producer"},
    {"id": "frontier", "role": "evidence_owner"},
    {"id": "predecessor_selector", "role": "candidate_rank_owner"},
    {"id": "closure_planner", "role": "candidate_rank_owner"},
    {"id": "baseline_owner", "role": "candidate_rank_owner"},
    {"id": "selection_preverifier", "role": "proof_owner"},
    {"id": "closure_verifier", "role": "proof_owner"},
    {"id": "all_cases_barrier", "role": "authorization_owner"},
    {"id": "private_resolver", "role": "producer"},
    {"id": "resolved_effect", "role": "evidence_owner"},
    {"id": "safety_verifier", "role": "authorization_owner"},
    {"id": "worker", "role": "mutation_owner"},
    {"id": "post_state", "role": "evidence_owner"},
    {"id": "observer", "role": "observer"},
    {"id": "final_truth", "role": "evidence_owner"},
    {"id": "final_verifier", "role": "proof_owner"},
    {"id": "oracle_baseline_evaluator", "role": "proof_owner"},
    {"id": "attempt_journal", "role": "evidence_owner"},
    {"id": "control_evaluator", "role": "proof_owner"},
    {"id": "terminal_evaluator", "role": "proof_owner"},
    {"id": "sealed_verdict", "role": "evidence_owner"},
    {"id": "cleanup_authorizer", "role": "authorization_owner"},
    {"id": "cleanup_owner", "role": "mutation_owner"},
    {"id": "cleanup_state", "role": "evidence_owner"},
    {"id": "cleanup_verifier", "role": "proof_owner"},
    {"id": "cleanup_receipt", "role": "evidence_owner"},
    {"id": "result_publisher", "role": "render_owner"}
  ],
  "edges": [
    {"id": "auth-input-owner", "from": "authorization_input", "relation": "passes_to", "to": "authorization_slot_owner", "events": ["authorize"]},
    {"id": "auth-owner-slot", "from": "authorization_slot_owner", "relation": "authorizes", "to": "slot_ledger", "events": ["claim_slot"]},
    {"id": "exec-confirm-generator", "from": "confirm_owner", "relation": "calls", "to": "generator", "events": ["generate_confirm", "generate_rehearsal"]},
    {"id": "data-generator-public", "from": "generator", "relation": "produces_for", "to": "public_batch", "events": ["publish_generated"]},
    {"id": "exec-confirm-coordinator", "from": "confirm_owner", "relation": "calls", "to": "public_coordinator", "events": ["public_prepare"]},
    {"id": "exec-coordinator-learner", "from": "public_coordinator", "relation": "calls", "to": "learner", "events": ["induce_models"]},
    {"id": "data-learner-models", "from": "learner", "relation": "produces_for", "to": "model_sets", "events": ["publish_models"]},
    {"id": "exec-coordinator-enumerator", "from": "public_coordinator", "relation": "calls", "to": "probe_enumerator", "events": ["enumerate_frontier"]},
    {"id": "data-enumerator-frontier", "from": "probe_enumerator", "relation": "produces_for", "to": "frontier", "events": ["publish_frontier"]},
    {"id": "rank-frontier-first", "from": "frontier", "relation": "passes_to", "to": "predecessor_selector", "events": ["rank_first"]},
    {"id": "rank-frontier-closure", "from": "frontier", "relation": "passes_to", "to": "closure_planner", "events": ["rank_closure"]},
    {"id": "rank-frontier-baseline", "from": "frontier", "relation": "passes_to", "to": "baseline_owner", "events": ["rank_baselines"]},
    {"id": "prove-first-preverify", "from": "predecessor_selector", "relation": "proves", "to": "selection_preverifier", "events": ["preverify_first"]},
    {"id": "prove-closure-preverify", "from": "closure_planner", "relation": "proves", "to": "closure_verifier", "events": ["preverify_closure"]},
    {"id": "authorize-first-barrier", "from": "predecessor_selector", "relation": "passes_to", "to": "all_cases_barrier", "events": ["commit_first"]},
    {"id": "authorize-closure-barrier", "from": "closure_planner", "relation": "passes_to", "to": "all_cases_barrier", "events": ["commit_closure"]},
    {"id": "authorize-baseline-barrier", "from": "baseline_owner", "relation": "passes_to", "to": "all_cases_barrier", "events": ["commit_baselines"]},
    {"id": "exec-confirm-resolver", "from": "confirm_owner", "relation": "calls", "to": "private_resolver", "events": ["resolve_step"]},
    {"id": "data-resolver-effect", "from": "private_resolver", "relation": "produces_for", "to": "resolved_effect", "events": ["publish_effect"]},
    {"id": "auth-effect-safety", "from": "resolved_effect", "relation": "passes_to", "to": "safety_verifier", "events": ["authorize_effect"]},
    {"id": "auth-safety-worker", "from": "safety_verifier", "relation": "authorizes", "to": "worker", "events": ["authorize_effect"]},
    {"id": "exec-confirm-worker", "from": "confirm_owner", "relation": "calls", "to": "worker", "events": ["execute_step"]},
    {"id": "observe-state-observer", "from": "post_state", "relation": "observes", "to": "observer", "events": ["observe_step"]},
    {"id": "prove-observer-final", "from": "observer", "relation": "proves", "to": "final_verifier", "events": ["verify_case"]},
    {"id": "prove-truth-oracle", "from": "final_truth", "relation": "proves", "to": "oracle_baseline_evaluator", "events": ["evaluate_oracle_baselines"]},
    {"id": "prove-journal-controls", "from": "attempt_journal", "relation": "proves", "to": "control_evaluator", "events": ["evaluate_controls"]},
    {"id": "prove-final-terminal", "from": "final_verifier", "relation": "proves", "to": "terminal_evaluator", "events": ["terminal_final_input"]},
    {"id": "prove-oracle-terminal", "from": "oracle_baseline_evaluator", "relation": "proves", "to": "terminal_evaluator", "events": ["terminal_oracle_input"]},
    {"id": "prove-controls-terminal", "from": "control_evaluator", "relation": "proves", "to": "terminal_evaluator", "events": ["terminal_control_input"]},
    {"id": "auth-verdict-cleanup", "from": "sealed_verdict", "relation": "passes_to", "to": "cleanup_authorizer", "events": ["authorize_cleanup"]},
    {"id": "auth-cleanup-owner", "from": "cleanup_authorizer", "relation": "authorizes", "to": "cleanup_owner", "events": ["authorize_cleanup"]},
    {"id": "exec-confirm-cleanup", "from": "confirm_owner", "relation": "calls", "to": "cleanup_owner", "events": ["execute_cleanup"]},
    {"id": "prove-cleanup-verifier", "from": "cleanup_state", "relation": "proves", "to": "cleanup_verifier", "events": ["verify_cleanup"]},
    {"id": "data-verdict-result", "from": "sealed_verdict", "relation": "passes_to", "to": "result_publisher", "events": ["bind_result_verdict"]},
    {"id": "data-cleanup-result", "from": "cleanup_receipt", "relation": "passes_to", "to": "result_publisher", "events": ["bind_result_cleanup"]}
  ],
  "routes": [
    {"id": "authorization-authority", "event": "authorize", "kind": "authority", "entry": "authorization_input", "terminal": "authorization_slot_owner", "required_roles": ["interface", "authorization_owner"]},
    {"id": "slot-claim-authority", "event": "claim_slot", "kind": "authority", "entry": "authorization_slot_owner", "terminal": "slot_ledger", "required_roles": ["authorization_owner", "mutation_owner"]},
    {"id": "confirm-generator-execution", "event": "generate_confirm", "kind": "execution", "entry": "confirm_owner", "terminal": "generator", "required_roles": ["orchestrator", "producer"], "path_cardinality": [{"from": "confirm_owner", "to": "generator", "min": 1, "max": 1}]},
    {"id": "rehearsal-generator-execution", "event": "generate_rehearsal", "kind": "execution", "entry": "confirm_owner", "terminal": "generator", "required_roles": ["orchestrator", "producer"], "path_cardinality": [{"from": "confirm_owner", "to": "generator", "min": 1, "max": 1}]},
    {"id": "generated-public-authority", "event": "publish_generated", "kind": "authority", "entry": "generator", "terminal": "public_batch", "required_roles": ["producer", "evidence_owner"]},
    {"id": "public-coordinator-execution", "event": "public_prepare", "kind": "execution", "entry": "confirm_owner", "terminal": "public_coordinator", "required_roles": ["orchestrator"], "path_cardinality": [{"from": "confirm_owner", "to": "public_coordinator", "min": 1, "max": 1}]},
    {"id": "learner-execution", "event": "induce_models", "kind": "execution", "entry": "public_coordinator", "terminal": "learner", "required_roles": ["orchestrator", "producer"], "path_cardinality": [{"from": "public_coordinator", "to": "learner", "min": 1, "max": 1}]},
    {"id": "model-evidence-authority", "event": "publish_models", "kind": "authority", "entry": "learner", "terminal": "model_sets", "required_roles": ["producer", "evidence_owner"]},
    {"id": "frontier-execution", "event": "enumerate_frontier", "kind": "execution", "entry": "public_coordinator", "terminal": "probe_enumerator", "required_roles": ["orchestrator", "producer"], "path_cardinality": [{"from": "public_coordinator", "to": "probe_enumerator", "min": 1, "max": 1}]},
    {"id": "frontier-evidence-authority", "event": "publish_frontier", "kind": "authority", "entry": "probe_enumerator", "terminal": "frontier", "required_roles": ["producer", "evidence_owner"]},
    {"id": "first-ranking-authority", "event": "rank_first", "kind": "authority", "entry": "frontier", "terminal": "predecessor_selector", "required_roles": ["evidence_owner", "candidate_rank_owner"]},
    {"id": "closure-ranking-authority", "event": "rank_closure", "kind": "authority", "entry": "frontier", "terminal": "closure_planner", "required_roles": ["evidence_owner", "candidate_rank_owner"]},
    {"id": "baseline-ranking-authority", "event": "rank_baselines", "kind": "authority", "entry": "frontier", "terminal": "baseline_owner", "required_roles": ["evidence_owner", "candidate_rank_owner"]},
    {"id": "first-preverification", "event": "preverify_first", "kind": "proof", "entry": "predecessor_selector", "terminal": "selection_preverifier", "required_roles": ["candidate_rank_owner", "proof_owner"]},
    {"id": "closure-preverification", "event": "preverify_closure", "kind": "proof", "entry": "closure_planner", "terminal": "closure_verifier", "required_roles": ["candidate_rank_owner", "proof_owner"]},
    {"id": "first-barrier-authority", "event": "commit_first", "kind": "authority", "entry": "predecessor_selector", "terminal": "all_cases_barrier", "required_roles": ["candidate_rank_owner", "authorization_owner"]},
    {"id": "closure-barrier-authority", "event": "commit_closure", "kind": "authority", "entry": "closure_planner", "terminal": "all_cases_barrier", "required_roles": ["candidate_rank_owner", "authorization_owner"]},
    {"id": "baseline-barrier-authority", "event": "commit_baselines", "kind": "authority", "entry": "baseline_owner", "terminal": "all_cases_barrier", "required_roles": ["candidate_rank_owner", "authorization_owner"]},
    {"id": "resolver-execution", "event": "resolve_step", "kind": "execution", "entry": "confirm_owner", "terminal": "private_resolver", "required_roles": ["orchestrator", "producer"], "path_cardinality": [{"from": "confirm_owner", "to": "private_resolver", "min": 1, "max": 1}]},
    {"id": "resolved-effect-authority", "event": "publish_effect", "kind": "authority", "entry": "private_resolver", "terminal": "resolved_effect", "required_roles": ["producer", "evidence_owner"]},
    {"id": "safety-authority", "event": "authorize_effect", "kind": "authority", "entry": "resolved_effect", "terminal": "worker", "required_roles": ["evidence_owner", "authorization_owner", "mutation_owner"]},
    {"id": "worker-execution", "event": "execute_step", "kind": "execution", "entry": "confirm_owner", "terminal": "worker", "required_roles": ["orchestrator", "mutation_owner"], "path_cardinality": [{"from": "confirm_owner", "to": "worker", "min": 1, "max": 1}]},
    {"id": "post-state-observation", "event": "observe_step", "kind": "observation", "entry": "post_state", "terminal": "observer", "required_roles": ["evidence_owner", "observer"]},
    {"id": "case-final-proof", "event": "verify_case", "kind": "proof", "entry": "observer", "terminal": "final_verifier", "required_roles": ["observer", "proof_owner"]},
    {"id": "oracle-baseline-proof", "event": "evaluate_oracle_baselines", "kind": "proof", "entry": "final_truth", "terminal": "oracle_baseline_evaluator", "required_roles": ["evidence_owner", "proof_owner"]},
    {"id": "attempt-control-proof", "event": "evaluate_controls", "kind": "proof", "entry": "attempt_journal", "terminal": "control_evaluator", "required_roles": ["evidence_owner", "proof_owner"]},
    {"id": "terminal-final-proof", "event": "terminal_final_input", "kind": "proof", "entry": "final_verifier", "terminal": "terminal_evaluator", "required_roles": ["proof_owner"]},
    {"id": "terminal-oracle-proof", "event": "terminal_oracle_input", "kind": "proof", "entry": "oracle_baseline_evaluator", "terminal": "terminal_evaluator", "required_roles": ["proof_owner"]},
    {"id": "terminal-control-proof", "event": "terminal_control_input", "kind": "proof", "entry": "control_evaluator", "terminal": "terminal_evaluator", "required_roles": ["proof_owner"]},
    {"id": "cleanup-authorization", "event": "authorize_cleanup", "kind": "authority", "entry": "sealed_verdict", "terminal": "cleanup_owner", "required_roles": ["evidence_owner", "authorization_owner", "mutation_owner"]},
    {"id": "cleanup-execution", "event": "execute_cleanup", "kind": "execution", "entry": "confirm_owner", "terminal": "cleanup_owner", "required_roles": ["orchestrator", "mutation_owner"], "path_cardinality": [{"from": "confirm_owner", "to": "cleanup_owner", "min": 1, "max": 1}]},
    {"id": "cleanup-proof", "event": "verify_cleanup", "kind": "proof", "entry": "cleanup_state", "terminal": "cleanup_verifier", "required_roles": ["evidence_owner", "proof_owner"]},
    {"id": "result-verdict-authority", "event": "bind_result_verdict", "kind": "authority", "entry": "sealed_verdict", "terminal": "result_publisher", "required_roles": ["evidence_owner", "render_owner"]},
    {"id": "result-cleanup-authority", "event": "bind_result_cleanup", "kind": "authority", "entry": "cleanup_receipt", "terminal": "result_publisher", "required_roles": ["evidence_owner", "render_owner"]}
  ]
}
