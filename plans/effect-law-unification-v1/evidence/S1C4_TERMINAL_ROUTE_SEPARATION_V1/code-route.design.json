    {"id":"legacy-health-authority","event":"legacy_health_projection","kind":"authority","entry":"legacy_config_reader","terminal":"cold_health_renderer","required_roles":["producer","evidence_owner","display_rank_owner","render_owner"],"path_cardinality":[{"from":"legacy_config_reader","to":"cold_health_renderer","min":1,"max":1}]},
    {"id":"transport-health-authority","event":"transport_health_projection","kind":"authority","entry":"remote_spool","terminal":"cold_health_renderer","required_roles":["producer","evidence_owner","display_rank_owner","render_owner"],"path_cardinality":[{"from":"remote_spool","to":"cold_health_renderer","min":1,"max":1}]},
    {"id":"dashboard-k1-authority","event":"dashboard_refresh","kind":"authority","entry":"k1_summary","terminal":"dashboard_renderer","required_roles":["candidate_rank_owner","display_rank_owner","render_owner"],"path_cardinality":[{"from":"k1_summary","to":"dashboard_renderer","min":1,"max":1}]},
    {"id":"dashboard-s1c-authority","event":"dashboard_refresh","kind":"authority","entry":"s1c4_report","terminal":"dashboard_renderer","required_roles":["evidence_owner","display_rank_owner","render_owner"],"path_cardinality":[{"from":"s1c4_report","to":"dashboard_renderer","min":1,"max":1}]},
    {"id":"health-proof","event":"health_test","kind":"proof","entry":"legacy_route_projector","terminal":"route_test","required_roles":["display_rank_owner","proof_owner"]},
    {"id":"dashboard-proof","event":"dashboard_test","kind":"proof","entry":"dashboard_api","terminal":"route_test","required_roles":["display_rank_owner","proof_owner"]},
    {"id":"live-observation","event":"live_check","kind":"observation","entry":"dashboard_renderer","terminal":"live_observer","required_roles":["render_owner","observer"]}
