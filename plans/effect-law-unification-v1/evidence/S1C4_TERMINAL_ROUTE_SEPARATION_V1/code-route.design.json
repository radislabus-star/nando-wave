    {"id":"legacy_config_reader","role":"producer"},
    {"id":"legacy_route_state","role":"evidence_owner"},
    {"id":"legacy_route_projector","role":"display_rank_owner"},
    {"id":"cold_health_renderer","role":"render_owner"},
    {"id":"remote_spool","role":"producer"},
    {"id":"remote_transport_state","role":"evidence_owner"},
    {"id":"remote_transport_projector","role":"display_rank_owner"},
    {"id":"dashboard_api","role":"display_rank_owner"},
    {"id":"s1c4_report","role":"evidence_owner"},
    {"id":"k1_summary","role":"candidate_rank_owner"},
    {"id":"dashboard_renderer","role":"render_owner"},
    {"id":"route_test","role":"proof_owner"},
    {"id":"live_observer","role":"observer"}
