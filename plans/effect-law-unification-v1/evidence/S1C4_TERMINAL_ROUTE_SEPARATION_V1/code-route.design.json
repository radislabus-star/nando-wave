    {"id":"authority-spool-state","from":"remote_spool","relation":"produces_for","to":"remote_transport_state","events":["transport_health_projection"]},
    {"id":"authority-transport-projector","from":"remote_transport_state","relation":"passes_to","to":"remote_transport_projector","events":["transport_health_projection"]},
    {"id":"authority-transport-renderer","from":"remote_transport_projector","relation":"passes_to","to":"cold_health_renderer","events":["transport_health_projection"]},
    {"id":"authority-k1-api","from":"k1_summary","relation":"passes_to","to":"dashboard_api","events":["dashboard_refresh"]},
    {"id":"authority-s1c-api","from":"s1c4_report","relation":"passes_to","to":"dashboard_api","events":["dashboard_refresh"]},
    {"id":"authority-api-renderer","from":"dashboard_api","relation":"passes_to","to":"dashboard_renderer","events":["dashboard_refresh"]},
