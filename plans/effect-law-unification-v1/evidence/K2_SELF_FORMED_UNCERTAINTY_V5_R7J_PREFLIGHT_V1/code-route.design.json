{
  "schema": "nanda.code-route-gate.v2",
  "scope": "design",
  "nodes": [
    {"id":"case_descriptor","role":"interface"},
    {"id":"case_evidence_tree","role":"evidence_owner"},
    {"id":"manifest_validator","role":"observer"},
    {"id":"frontier_reconstructor","role":"candidate_rank_owner"},
    {"id":"oracle_baseline_evaluator","role":"proof_owner"},
    {"id":"oracle_batch_receipt","role":"evidence_owner"},
    {"id":"control_process_outcomes","role":"evidence_owner"},
    {"id":"control_evaluator","role":"proof_owner"},
    {"id":"control_receipt","role":"evidence_owner"},
    {"id":"terminal_receipt_set","role":"evidence_owner"},
    {"id":"terminal_evaluator","role":"proof_owner"},
    {"id":"terminal_verdict","role":"evidence_owner"}
  ],
  "edges": [
    {"id":"observe-evidence-manifest","from":"case_evidence_tree","relation":"observes","to":"manifest_validator","events":["validate_case"]},
    {"id":"execute-descriptor-validation","from":"case_descriptor","relation":"calls","to":"manifest_validator","events":["evaluate_case"]},
    {"id":"execute-manifest-frontier","from":"manifest_validator","relation":"delegates","to":"frontier_reconstructor","events":["evaluate_case"]},
    {"id":"execute-frontier-oracle","from":"frontier_reconstructor","relation":"delegates","to":"oracle_baseline_evaluator","events":["evaluate_case"]},
    {"id":"proof-oracle-batch","from":"case_evidence_tree","relation":"proves","to":"oracle_baseline_evaluator","events":["evaluate_batch"]},
    {"id":"proof-control-outcomes","from":"control_process_outcomes","relation":"proves","to":"control_evaluator","events":["evaluate_controls"]},
    {"id":"proof-terminal-input","from":"terminal_receipt_set","relation":"proves","to":"terminal_evaluator","events":["evaluate_terminal"]}
  ],
  "routes": [
    {"id":"case-evidence-observation","event":"validate_case","kind":"observation","entry":"case_evidence_tree","terminal":"manifest_validator","required_roles":["evidence_owner","observer"],"path_cardinality":[{"from":"case_evidence_tree","to":"manifest_validator","min":1,"max":1}]},
    {"id":"oracle-case-execution","event":"evaluate_case","kind":"execution","entry":"case_descriptor","terminal":"oracle_baseline_evaluator","required_roles":["interface","observer","candidate_rank_owner","proof_owner"],"path_cardinality":[{"from":"case_descriptor","to":"oracle_baseline_evaluator","min":1,"max":1}]},
    {"id":"oracle-batch-proof","event":"evaluate_batch","kind":"proof","entry":"case_evidence_tree","terminal":"oracle_baseline_evaluator","required_roles":["evidence_owner","proof_owner"],"path_cardinality":[{"from":"case_evidence_tree","to":"oracle_baseline_evaluator","min":1,"max":1}]},
    {"id":"control-proof","event":"evaluate_controls","kind":"proof","entry":"control_process_outcomes","terminal":"control_evaluator","required_roles":["evidence_owner","proof_owner"],"path_cardinality":[{"from":"control_process_outcomes","to":"control_evaluator","min":1,"max":1}]},
    {"id":"terminal-proof","event":"evaluate_terminal","kind":"proof","entry":"terminal_receipt_set","terminal":"terminal_evaluator","required_roles":["evidence_owner","proof_owner"],"path_cardinality":[{"from":"terminal_receipt_set","to":"terminal_evaluator","min":1,"max":1}]}
  ]
}
