      "test_id": "schema-parity"
    }
  ],
  "tests": [
    {
      "id": "prepare-copy-fault",
      "kind": "fault_injection",
      "expected": "terminal PREFLIGHT_FAILURE and no production mutation"
    },
    {
      "id": "execute-rollback-fault",
      "kind": "fault_injection",
      "expected": "ROLLBACK_PASS with exact baseline pair and ledger prefix suffix preservation"
    },
    {
      "id": "finalize-veto-fault",
      "kind": "fault_injection",
      "expected": "connector veto rolls back and seals VETO"
    },
    {
      "id": "stable-projection-unit",
      "kind": "unit",
      "expected": "exact endpoint projections pass and whole object raw hash missing key and wrong endpoint variants fail"
    },
    {
      "id": "dual-owner-parity",
      "kind": "parity",
      "expected": "semantic health and route receipt paths call the same projection owner"
    },
    {
      "id": "ledger-prefix-parity",
      "kind": "parity",
      "expected": "existing prefix and natural suffix survive rollback byte-identically"
    },
    {
      "id": "route-read-only",
      "kind": "unit",
      "expected": "no POST or responses endpoint exists in the active route receipt owner"
    },
    {
      "id": "projection-verifier-parity",
      "kind": "parity",
      "expected": "executor and independent verifier bind identical endpoint projection schemas"
    },
    {
      "id": "verifier-parity",
      "kind": "parity",
      "expected": "local and remote verifier JSON bytes are identical"
    },
    {
      "id": "schema-parity",
      "kind": "parity",
      "expected": "all terminal files expose only S1C3G namespace"
    }
  ]
