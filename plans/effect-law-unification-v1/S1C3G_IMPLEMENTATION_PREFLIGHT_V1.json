  "state_machine": {
    "initial_state": "NEW",
    "terminal_states": [
      "PASS",
      "PREFLIGHT_FAILURE",
      "ROLLBACK_PASS",
      "VETO"
    ],
    "steps": [
      {
        "id": "prepare",
        "from": "NEW",
        "to": "PREPARED",
        "mutates": true,
        "failure_state": "PREFLIGHT_FAILURE",
        "cleanup": "seal failure receipt and leave production untouched",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "prepare-copy-fault"
      },
      {
        "id": "execute",
        "from": "PREPARED",
        "to": "FINALIZE_PENDING",
        "mutates": true,
        "failure_state": "ROLLBACK_PASS",
        "cleanup": "restore baseline binary and config while preserving natural suffix",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "execute-rollback-fault"
      },
      {
        "id": "finalize",
        "from": "FINALIZE_PENDING",
        "to": "PASS",
        "mutates": true,
        "failure_state": "VETO",
        "cleanup": "connector veto invokes rollback before terminal sealing",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "finalize-veto-fault"
      }
    ]
  },
  "invariants": [
    {
      "id": "endpoint-owned-stable-projection",
      "statement": "each endpoint exposes and compares only its frozen stable fields",
      "test_id": "stable-projection-unit"
