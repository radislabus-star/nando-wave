  "state_machine": {
    "initial_state": "PAPER_PASS",
    "terminal_states": [
      "IMPLEMENTED",
      "LOCAL_FAILURE",
      "DEPLOYMENT_ROLLBACK_PASS",
      "VETO"
    ],
    "steps": [
      {
        "id": "implement-projections",
        "from": "PAPER_PASS",
        "to": "PROJECTIONS_IMPLEMENTED",
        "mutates": true,
        "failure_state": "LOCAL_FAILURE",
        "cleanup": "retain local diagnostics and leave production untouched",
        "preserves": ["s1c4-terminal-report"],
        "test_id": "projection-test-fault"
      },
      {
        "id": "verify-local",
        "from": "PROJECTIONS_IMPLEMENTED",
        "to": "LOCAL_VERIFIED",
        "mutates": false
      },
      {
        "id": "stage-deployment",
        "from": "LOCAL_VERIFIED",
        "to": "ROLLBACK_ARMED",
        "mutates": true,
        "failure_state": "LOCAL_FAILURE",
        "cleanup": "remove unreferenced staging only and leave production runtime untouched",
        "preserves": ["s1c4-terminal-report"],
        "test_id": "deployment-stage-fault"
      },
      {
        "id": "install-cold-control",
        "from": "ROLLBACK_ARMED",
        "to": "SCOPED_RUNTIME_INSTALLED",
        "mutates": true,
        "failure_state": "DEPLOYMENT_ROLLBACK_PASS",
        "cleanup": "restore previous cold and control binaries while preserving terminal and append-only evidence",
        "preserves": ["s1c4-terminal-report"],
        "test_id": "scoped-install-fault"
      },
      {
        "id": "verify-live",
        "from": "SCOPED_RUNTIME_INSTALLED",
        "to": "IMPLEMENTED",
        "mutates": true,
        "failure_state": "DEPLOYMENT_ROLLBACK_PASS",
        "cleanup": "persist diagnostics and restore previous cold and control binaries without touching hot, Nginx, connector or evidence",
        "preserves": ["s1c4-terminal-report"],
        "test_id": "live-runtime-fault"
      }
    ]
  },
