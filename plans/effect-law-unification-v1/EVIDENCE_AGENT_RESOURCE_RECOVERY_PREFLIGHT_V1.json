  "state_machine": {
    "initial_state": "AGENT_STOPPED",
    "terminal_states": [
      "RECOVERY_PASS",
      "BUILD_FAILED",
      "BACKUP_FAILED",
      "KEY_ROTATION_FAILED",
      "INSTALL_FAILED",
      "RUNTIME_GATE_FAILED"
    ],
    "steps": [
      {
        "id": "build-and-test",
        "from": "AGENT_STOPPED",
        "to": "CANDIDATE_VERIFIED",
        "mutates": false
      },
      {
        "id": "archive-old-epoch",
        "from": "CANDIDATE_VERIFIED",
        "to": "OLD_EPOCH_ARCHIVED",
        "mutates": true,
        "failure_state": "BACKUP_FAILED",
        "cleanup": "remove_incomplete_backup_only",
        "preserves": [
          "old-agent-state",
          "old-agent-pending",
          "old-outbox-5383",
          "old-outbox-5384",
          "old-outbox-5385"
        ],
        "test_id": "backup-fault"
      },
      {
        "id": "rotate-client-identity",
        "from": "OLD_EPOCH_ARCHIVED",
        "to": "NEW_CLIENT_CONFIGURED",
        "mutates": true,
        "failure_state": "KEY_ROTATION_FAILED",
        "cleanup": "remove_new_key_and_restore_old_local_key",
        "preserves": [
          "old-agent-state",
          "old-agent-pending",
          "old-outbox-5383",
          "old-outbox-5384",
          "old-outbox-5385"
        ],
        "test_id": "key-rotation-fault"
      },
      {
        "id": "install-candidate",
        "from": "NEW_CLIENT_CONFIGURED",
        "to": "CANDIDATE_ACTIVE",
        "mutates": true,
        "failure_state": "INSTALL_FAILED",
        "cleanup": "transactional_installer_restores_previous_binary_unit_and_service_state",
        "preserves": [
          "old-agent-state",
          "old-agent-pending",
          "old-outbox-5383",
          "old-outbox-5384",
          "old-outbox-5385"
        ],
        "test_id": "installer-rollback"
      },
      {
        "id": "runtime-resource-gate",
        "from": "CANDIDATE_ACTIVE",
        "to": "RECOVERY_PASS",
        "mutates": true,
        "failure_state": "RUNTIME_GATE_FAILED",
        "cleanup": "stop_candidate_and_restore_previous_binary_unit_key_and_state",
        "preserves": [
          "old-agent-state",
          "old-agent-pending",
          "old-outbox-5383",
          "old-outbox-5384",
          "old-outbox-5385"
        ],
        "test_id": "runtime-gate-fault"
      }
    ]
  },
  "invariants": [
    {
      "id": "no-session-replay-storm",
      "statement": "Unchanged Codex JSONL files are never reread after startup registration.",
      "test_id": "unchanged-session-io"
    },
    {
      "id": "bounded-outbox-memory",
      "statement": "Outbox payloads remain on disk and only one bounded remote batch is materialized.",
      "test_id": "outbox-memory-bound"
    },
    {
      "id": "old-epoch-preserved",
      "statement": "The sequence-5477 local branch and all queued natural evidence remain byte-verifiable after rollover.",
      "test_id": "legacy-evidence-parity"
    },
    {
      "id": "connector-unaffected",
      "statement": "The local connector PID and health route survive evidence-agent deployment.",
      "test_id": "connector-parity"
    }
  ],
  "identity_contracts": [
    {
      "id": "client-key-identity",
      "producer": "local SHA-256 of the rotated 32-byte evidence key",
      "consumer": "mini-PC evidence-clients filename and key bytes",
      "comparison": "exact key SHA-256 and byte parity",
      "test_id": "client-key-parity"
    },
    {
      "id": "outbox-frame-identity",
      "producer": "disk-indexed RouteBoundOutboxFrameV1 record",
      "consumer": "RemoteEvidenceBatchV1 frame",
      "comparison": "exact canonical frame and transport-binding parity",
      "test_id": "outbox-frame-parity"
    }
  ],
  "runtime_comparisons": [
    {
      "id": "local-runtime-projection",
      "source": "systemd user service plus procfs and local gateway health",
      "comparison": "exact_stable_projection",
      "reason": "resource repair must not interrupt the connector or restore swap growth",
      "test_id": "connector-parity",
      "stable_fields": [
        "connector_pid",
        "gateway_health_service",
        "legacy_backup_hashes"
      ],
      "expected_to_change_fields": [
        "evidence_agent_pid",
        "evidence_client_id",
        "accepted_batches"
      ],
      "observed_not_compared_fields": [
        "codex_session_sizes",
        "system_page_cache_bytes"
      ]
    }
  ],
  "tests": [
    {
      "id": "backup-fault",
      "kind": "fault_injection",
      "expected": "partial backup is removed and every original evidence byte remains in place"
    },
    {
      "id": "key-rotation-fault",
      "kind": "fault_injection",
      "expected": "new client key is not activated unless local and remote copies are byte-identical"
    },
    {
      "id": "installer-rollback",
      "kind": "fault_injection",
      "expected": "failed readiness restores previous binary, unit and stopped service state"
    },
    {
      "id": "runtime-gate-fault",
      "kind": "fault_injection",
      "expected": "resource-limit or transport failure stops candidate and leaves immutable old epoch backup"
    },
    {
      "id": "unchanged-session-io",
      "kind": "integration",
      "expected": "no reads from unchanged large JSONL files during an idle observation window"
    },
    {
      "id": "outbox-memory-bound",
      "kind": "integration",
      "expected": "a multi-segment outbox opens and drains below MemoryMax without swap growth"
    },
    {
      "id": "legacy-evidence-parity",
      "kind": "parity",
      "expected": "all five frozen artifact SHA-256 values match their immutable backup copies"
    },
    {
      "id": "connector-parity",
      "kind": "parity",
      "expected": "connector PID and gateway health identity are unchanged"
    },
    {
      "id": "client-key-parity",
      "kind": "parity",
      "expected": "local key SHA-256 equals remote configured client id and remote key SHA-256"
    },
    {
      "id": "outbox-frame-parity",
      "kind": "parity",
      "expected": "disk-indexed frames produce the same canonical remote batch as in-memory frames"
    }
  ]
}
