  "state_machine": {
    "initial_state": "NEW",
    "terminal_states": [
      "PASS",
      "PREFLIGHT_FAILURE",
      "ROLLBACK_PASS",
      "VETO"
    ],
    "steps": [
      {
        "id": "prepare",
        "from": "NEW",
        "to": "PREPARED",
        "mutates": true,
        "failure_state": "PREFLIGHT_FAILURE",
        "cleanup": "seal diagnostic and leave production untouched",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "prepare-copy-fault"
      },
      {
        "id": "stage-candidate",
        "from": "PREPARED",
        "to": "STAGED",
        "mutates": true,
        "failure_state": "PREFLIGHT_FAILURE",
        "cleanup": "remove only unreferenced transaction staging and leave production untouched",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "stage-authority-fault"
      },
      {
        "id": "arm-rollback",
        "from": "STAGED",
        "to": "ROLLBACK_ARMED",
        "mutates": true,
        "failure_state": "PREFLIGHT_FAILURE",
        "cleanup": "leave production untouched and preserve durable backups",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "rollback-arm-fault"
      },
      {
        "id": "install-authority-unit",
        "from": "ROLLBACK_ARMED",
        "to": "AUTHORITY_INSTALLED",
        "mutates": true,
        "failure_state": "ROLLBACK_PASS",
        "cleanup": "persist candidate diagnostics then restore complete old compatibility unit",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "authority-install-fault"
      },
      {
        "id": "install-runtime-unit",
        "from": "AUTHORITY_INSTALLED",
        "to": "RUNTIME_INSTALLED",
        "mutates": true,
        "failure_state": "ROLLBACK_PASS",
        "cleanup": "persist candidate diagnostics then restore complete old compatibility unit",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "runtime-install-fault"
      },
      {
        "id": "survival",
        "from": "RUNTIME_INSTALLED",
        "to": "FINALIZE_PENDING",
        "mutates": true,
        "failure_state": "ROLLBACK_PASS",
        "cleanup": "persist candidate health and startup logs then restore complete old compatibility unit",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "survival-fault"
      },
      {
        "id": "finalize",
        "from": "FINALIZE_PENDING",
        "to": "PASS",
        "mutates": true,
        "failure_state": "VETO",
        "cleanup": "connector or final verifier veto invokes complete rollback before sealing",
        "preserves": [
          "decision-precommit-ledger",
          "goal-satisfaction-ledger",
          "selected-action-ledger"
        ],
        "test_id": "finalize-veto-fault"
      }
    ]
  },
  "invariants": [
    {
      "id": "pair-contract-identity",
      "statement": "installed transition and response-admission binaries report the same runtime contract digest",
      "test_id": "pair-contract-parity"
    },
    {
      "id": "admission-contract-identity",
      "statement": "final admission response authority runtime digest equals the installed pair digest",
      "test_id": "admission-contract-parity"
    },
    {
      "id": "mixed-pair-fail-closed",
      "statement": "no mixed runtime-authority state can satisfy installation PASS",
      "test_id": "mixed-pair-negative"
    },
    {
      "id": "diagnostic-before-rollback",
      "statement": "candidate stage health and logs are durably written before rollback starts",
      "test_id": "diagnostic-order"
    },
    {
      "id": "natural-suffix-preserved",
      "statement": "rollback preserves frozen prefixes and all valid naturally arriving suffix records",
      "test_id": "ledger-prefix-parity"
    }
  ],
  "identity_contracts": [
    {
      "id": "source-pair-identity",
      "producer": "candidate transition and response-admission release builds",
      "consumer": "transaction preparation and final verifier",
      "comparison": "same Git commit plus executable SHA and runtime contract SHA",
      "test_id": "pair-contract-parity"
    },
    {
      "id": "controller-gate-identity",
      "producer": "candidate response-admission sidecar generation",
      "consumer": "candidate composite gate final admission",
      "comparison": "exact registry root revision package set and runtime digest",
      "test_id": "admission-contract-parity"
    },
    {
      "id": "rollback-unit-identity",
      "producer": "durable pre-mutation rollback directory",
      "consumer": "rollback installer and final rollback verifier",
      "comparison": "exact file manifest and old pair runtime digest",
      "test_id": "rollback-unit-parity"
    },
    {
      "id": "verifier-byte-identity",
      "producer": "local independent verifier result",
      "consumer": "remote independent verifier result",
      "comparison": "canonical JSON byte identity",
      "test_id": "verifier-parity"
    }
  ],
  "tests": [
    {
      "id": "prepare-copy-fault",
      "kind": "fault_injection",
      "expected": "PREFLIGHT_FAILURE and no production mutation"
    },
    {
      "id": "stage-authority-fault",
      "kind": "fault_injection",
      "expected": "PREFLIGHT_FAILURE and no production mutation"
    },
    {
      "id": "rollback-arm-fault",
      "kind": "fault_injection",
      "expected": "PREFLIGHT_FAILURE with complete durable backups or no production mutation"
    },
    {
      "id": "authority-install-fault",
      "kind": "fault_injection",
      "expected": "ROLLBACK_PASS with complete old unit READY"
    },
    {
      "id": "runtime-install-fault",
      "kind": "fault_injection",
      "expected": "ROLLBACK_PASS with complete old unit READY"
    },
    {
      "id": "survival-fault",
      "kind": "fault_injection",
      "expected": "candidate diagnostics persisted before complete rollback"
    },
    {
      "id": "finalize-veto-fault",
      "kind": "fault_injection",
      "expected": "connector or verifier VETO completes rollback before terminal seal"
    },
    {
      "id": "pair-contract-parity",
      "kind": "parity",
      "expected": "both candidate and installed binaries report one exact runtime digest"
    },
    {
      "id": "admission-contract-parity",
      "kind": "parity",
      "expected": "sidecars final admission and installed pair share registry and runtime identity"
    },
    {
      "id": "mixed-pair-negative",
      "kind": "unit",
      "expected": "every old-new pair permutation fails verification"
    },
    {
      "id": "diagnostic-order",
      "kind": "unit",
      "expected": "diagnostic fsync precedes the first rollback mutation"
    },
    {
      "id": "ledger-prefix-parity",
      "kind": "parity",
      "expected": "frozen prefix and valid natural suffix remain byte-identical"
    },
    {
      "id": "stable-health-projection",
      "kind": "unit",
      "expected": "READY two-profile serving passes and authority or cache changes fail"
    },
    {
      "id": "rollback-fault-matrix",
      "kind": "fault_injection",
      "expected": "every mutating step restores the complete old unit"
    },
    {
      "id": "rollback-unit-parity",
      "kind": "parity",
      "expected": "rollback backups installed bytes final hashes and old runtime digest are identical"
    },
    {
      "id": "verifier-parity",
      "kind": "parity",
      "expected": "local and remote verifier JSON bytes are identical"
    }
  ]
}
