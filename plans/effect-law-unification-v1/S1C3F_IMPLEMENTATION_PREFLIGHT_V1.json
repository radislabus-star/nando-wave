  "state_machine": {
    "initial_state": "NEW",
    "terminal_states": ["PASS", "PREFLIGHT_FAILURE", "ROLLBACK_PASS", "VETO"],
    "steps": [
      {"id": "prepare", "from": "NEW", "to": "PREPARED", "mutates": true, "failure_state": "PREFLIGHT_FAILURE", "cleanup": "seal failure receipt and leave production untouched", "preserves": ["decision-precommit-ledger", "goal-satisfaction-ledger", "selected-action-ledger"], "test_id": "prepare-copy-fault"},
      {"id": "execute", "from": "PREPARED", "to": "FINALIZE_PENDING", "mutates": true, "failure_state": "ROLLBACK_PASS", "cleanup": "restore baseline binary/config and preserve natural suffix", "preserves": ["decision-precommit-ledger", "goal-satisfaction-ledger", "selected-action-ledger"], "test_id": "execute-rollback-fault"},
      {"id": "finalize", "from": "FINALIZE_PENDING", "to": "PASS", "mutates": true, "failure_state": "VETO", "cleanup": "connector veto invokes rollback before receipt", "preserves": ["decision-precommit-ledger", "goal-satisfaction-ledger", "selected-action-ledger"], "test_id": "finalize-veto-fault"}
    ]
  },
  "invariants": [
    {"id": "magic-is-format-not-record", "statement": "exact NTF1 header is four format bytes and zero records", "test_id": "parser-parity"},
    {"id": "natural-suffix-preserved", "statement": "rollback preserves frozen prefix and all valid naturally arriving suffix frames", "test_id": "ledger-prefix-parity"},
    {"id": "read-only-route-receipt", "statement": "route evidence uses GET health snapshots and creates no ordinary request", "test_id": "route-read-only"}
  ],
  "identity_contracts": [
    {"id": "parser-identity", "producer": "executor framed segment parser", "consumer": "independent verifier framed segment parser", "comparison": "typed field equality over identical bytes", "test_id": "parser-parity"},
    {"id": "verifier-byte-identity", "producer": "local verifier output", "consumer": "remote verifier output", "comparison": "byte identity before execute and seal", "test_id": "verifier-parity"},
    {"id": "schema-identity", "producer": "S1C3F executor receipts", "consumer": "S1C3F independent verifier", "comparison": "exact S1C3F schemas, verdicts, roots, and state filename", "test_id": "schema-parity"}
  ],
  "tests": [
    {"id": "prepare-copy-fault", "kind": "fault_injection", "expected": "terminal PREFLIGHT_FAILURE and no production mutation"},
    {"id": "execute-rollback-fault", "kind": "fault_injection", "expected": "ROLLBACK_PASS with exact baseline pair and ledger prefix/suffix preservation"},
    {"id": "finalize-veto-fault", "kind": "fault_injection", "expected": "connector veto rolls back and seals VETO"},
    {"id": "parser-parity", "kind": "parity", "expected": "executor and independent parser agree on magic-only and framed bytes"},
    {"id": "ledger-prefix-parity", "kind": "parity", "expected": "existing prefix and natural suffix survive rollback byte-identically"},
    {"id": "route-read-only", "kind": "unit", "expected": "no POST or responses endpoint exists in route receipt owner"},
    {"id": "verifier-parity", "kind": "parity", "expected": "local and remote verifier JSON bytes are identical"},
    {"id": "schema-parity", "kind": "parity", "expected": "all terminal files expose only S1C3F namespace"}
  ]
