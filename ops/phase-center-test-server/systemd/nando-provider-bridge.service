[Unit]
Description=Nando OpenAI-compatible fail-open provider bridge
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/nando-wave/phase-center.env
WorkingDirectory=/opt/nando-wave
ExecStartPre=/usr/bin/mkdir -p ${NANDO_STATE_DIR} ${NANDO_LOG_DIR}
ExecStart=/usr/bin/env python3 /opt/nando-wave/ops/phase-center-test-server/bin/nando-provider-bridge.py
Restart=always
RestartSec=2
CPUQuota=100%
MemoryHigh=64M
MemoryMax=256M
MemorySwapMax=0
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
