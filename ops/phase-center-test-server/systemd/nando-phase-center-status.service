[Unit]
Description=Nando phase-center status snapshot
After=network.target nando-provider-bridge.service nando-phase-center-test-server-verify.service
Wants=nando-provider-bridge.service nando-phase-center-test-server-verify.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nando-wave/phase-center.env
WorkingDirectory=/opt/nando-wave
ExecStartPre=/usr/bin/mkdir -p ${NANDO_METRICS_DIR}
ExecStart=/usr/bin/env /opt/nando-wave/ops/phase-center-test-server/bin/nando-phase-center-status.sh /etc/nando-wave/phase-center.env --write-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
