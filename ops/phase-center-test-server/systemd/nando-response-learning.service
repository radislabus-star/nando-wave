[Unit]
Description=Nando cold streaming response learner
After=network.target nando-gateway-control.service
Wants=nando-gateway-control.service

[Service]
Type=simple
User=ubu
Group=ubu
SupplementaryGroups=www-data
EnvironmentFile=/etc/nando-wave/phase-center.env
EnvironmentFile=/etc/nando-wave/roles/response-learning.env
WorkingDirectory=/opt/nando-wave
ExecStart=/opt/nando-wave/bin/nando-transition-serving
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/home/ubu/.codex/sessions
ReadOnlyPaths=-/var/lib/nando-gateway/economics-access.jsonl
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nando-wave/transition
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
