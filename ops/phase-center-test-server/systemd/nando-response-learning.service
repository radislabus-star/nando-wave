[Unit]
Description=Nando cold streaming response learner
After=network.target nando-gateway-control.service
Wants=nando-gateway-control.service

[Service]
Type=simple
User=ubu
Group=ubu
SupplementaryGroups=www-data
EnvironmentFile=/etc/nando-wave/phase-center.env
Environment=NANDO_TRANSITION_SERVING_BIND=127.0.0.1:18790
Environment=NANDO_EMBEDDED_RESPONSE_MINER_ENABLED=1
Environment=NANDO_GENERIC_RESPONSE_MINER_ENABLED=1
Environment=NANDO_PROVIDER_CAPTURE_ENABLED=0
Environment=NANDO_PROVIDER_CAPTURE_STORE=/var/lib/nando-wave/transition/f8e-controlled-shadow-v3/provider-capture-v3-f8a
Environment=NANDO_OPERATOR_GENERATION_SHADOW_ENABLED=1
Environment=NANDO_OPERATOR_GENERATION_STORE=/var/lib/nando-wave/transition/f8e-controlled-shadow-v3/operator-generation-v3
Environment=NANDO_OPERATOR_GENERATION_CAPTURE_INDEX=/var/lib/nando-wave/transition/f8e-controlled-shadow-v3/operator-generation-capture-v3.cbor
Environment=NANDO_OPERATOR_GENERATION_SHADOW_RECEIPT_STORE=/var/lib/nando-wave/transition/f8e-controlled-shadow-v3/operator-generation-shadow-v3-f8b
Environment=NANDO_OPERATOR_GENERATION_SHADOW_QUEUE=32
Environment=NANDO_OPERATOR_GENERATION_SHADOW_POLL_MS=1000
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_PRODUCER_ENABLED=0
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_CONSUMER_ENABLED=1
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_SOCKET=/var/lib/nando-wave/transition/learning-evidence-bridge-v1/bridge.sock
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_QUEUE=32
Environment=NANDO_LEARNING_STRUCTURE_BRIDGE_PRODUCER_ENABLED=0
Environment=NANDO_LEARNING_STRUCTURE_BRIDGE_CONSUMER_ENABLED=1
Environment=NANDO_LEARNING_STRUCTURE_BRIDGE_ROOT=/var/lib/nando-wave/transition/learning-structure-bridge-v2
Environment=NANDO_LEARNING_STRUCTURE_BRIDGE_POLL_MS=100
Environment=NANDO_OPPORTUNITY_BRIDGE_PRODUCER_ENABLED=0
Environment=NANDO_OPPORTUNITY_BRIDGE_CONSUMER_ENABLED=1
Environment=NANDO_OPPORTUNITY_BRIDGE_ROOT=/var/lib/nando-wave/transition/opportunity-bridge-v1
Environment=NANDO_MULTI_SOURCE_SNAPSHOT_PATH=/var/lib/nando-wave/transition/multi-source-live-v2/snapshot.cbor
Environment=NANDO_MULTI_SOURCE_SNAPSHOT_POLL_MS=15000
Environment=NANDO_NGINX_TERMINAL_JSONL=/var/lib/nando-gateway/economics-access.jsonl
Environment=NANDO_LOCAL_ACCEPT_ENABLED=0
Environment=NANDO_CLIENT_ALLOW_LOCAL_ACCEPT=0
Environment=NANDO_GATEWAY_CPU_ROUTE_READY=0
Environment=NANDO_FALLBACK_MANAGED_BY_NGINX=0
Environment=MIMALLOC_PURGE_DELAY=0
Environment=NANDO_TRANSITION_METRICS=/var/lib/nando-wave/transition/learning-runtime/metrics.json
Environment=NANDO_TRANSITION_TRACE_JSONL=/var/lib/nando-wave/transition/learning-runtime/live-transitions.jsonl
Environment=NANDO_TRANSITION_EXECUTION_EVENTS_JSONL=/var/lib/nando-wave/transition/learning-runtime/execution-events.jsonl
Environment=NANDO_ECONOMICS_LEDGER_JSONL=/var/lib/nando-wave/transition/learning-runtime/economics-terminal.jsonl
WorkingDirectory=/opt/nando-wave
ExecStart=/opt/nando-wave/bin/nando-transition-serving
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubu/.codex/sessions
ReadOnlyPaths=/var/lib/nando-gateway/economics-access.jsonl
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nando-wave/transition
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
