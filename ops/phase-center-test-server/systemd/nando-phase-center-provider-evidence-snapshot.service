[Unit]
Description=Nando phase-center provider evidence snapshot
After=network.target nando-phase-center-live-tail.service
Wants=nando-phase-center-live-tail.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nando-wave/phase-center.env
WorkingDirectory=/opt/nando-wave
ExecStartPre=/usr/bin/mkdir -p ${NANDO_PROVIDER_EVIDENCE_DIR}
ExecStart=/usr/bin/env /opt/nando-wave/ops/phase-center-test-server/bin/nando-phase-center-provider-evidence-snapshot.sh /etc/nando-wave/phase-center.env
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
