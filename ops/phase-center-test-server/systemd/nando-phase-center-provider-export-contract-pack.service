[Unit]
Description=Nando phase-center provider export contract pack
After=network.target nando-phase-center-provider-evidence-snapshot.service
Wants=nando-phase-center-provider-evidence-snapshot.service

[Service]
Type=oneshot
EnvironmentFile=/etc/nando-wave/phase-center.env
WorkingDirectory=/opt/nando-wave
ExecStartPre=/usr/bin/mkdir -p ${NANDO_PROVIDER_EXPORT_CONTRACT_DIR}
ExecStart=/usr/bin/env /opt/nando-wave/ops/phase-center-test-server/bin/nando-phase-center-provider-export-contract-pack.sh /etc/nando-wave/phase-center.env
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
