[Unit]
Description=Nando verifier-bound Rust transition serving worker
After=network.target nando-gateway-control.service nando-response-learning.service
Wants=nando-gateway-control.service nando-response-learning.service

[Service]
Type=simple
User=ubu
Group=ubu
EnvironmentFile=/etc/nando-wave/phase-center.env
EnvironmentFile=/etc/nando-wave/roles/transition-serving.env
EnvironmentFile=-/etc/nando-wave/authority.env
WorkingDirectory=/opt/nando-wave
ExecStart=/opt/nando-wave/bin/nando-transition-serving
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=-/home/ubu/.codex/sessions
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nando-wave/transition
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
