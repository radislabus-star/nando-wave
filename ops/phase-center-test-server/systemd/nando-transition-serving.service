[Unit]
Description=Nando verifier-bound Rust transition serving worker
After=network.target nando-gateway-control.service nando-response-learning.service
Wants=nando-gateway-control.service nando-response-learning.service

[Service]
Type=simple
User=ubu
Group=ubu
EnvironmentFile=/etc/nando-wave/phase-center.env
Environment=NANDO_TRANSITION_SERVING_BIND=127.0.0.1:18789
Environment=NANDO_GATEWAY_PUBLIC_MODE_JSON=/run/nando-gateway-control/mode.json
Environment=NANDO_LOCAL_ACCEPT_ENABLED=1
Environment=NANDO_CLIENT_ALLOW_LOCAL_ACCEPT=1
Environment=NANDO_GATEWAY_CPU_ROUTE_READY=1
Environment=NANDO_FALLBACK_MANAGED_BY_NGINX=1
Environment=NANDO_EMBEDDED_RESPONSE_MINER_ENABLED=0
Environment=NANDO_GENERIC_RESPONSE_MINER_ENABLED=0
Environment=NANDO_PROVIDER_CAPTURE_ENABLED=1
Environment=NANDO_PROVIDER_CAPTURE_STORE=/var/lib/nando-wave/transition/f8e-controlled-shadow-v3/provider-capture-v3-f8a
Environment=NANDO_PROVIDER_CAPTURE_QUEUE=32
Environment=NANDO_OPERATOR_GENERATION_SHADOW_ENABLED=0
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_PRODUCER_ENABLED=1
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_CONSUMER_ENABLED=0
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_SOCKET=/var/lib/nando-wave/transition/learning-evidence-bridge-v1/bridge.sock
Environment=NANDO_LEARNING_EVIDENCE_BRIDGE_QUEUE=32
Environment=NANDO_OPPORTUNITY_BRIDGE_PRODUCER_ENABLED=1
Environment=NANDO_OPPORTUNITY_BRIDGE_CONSUMER_ENABLED=0
Environment=NANDO_OPPORTUNITY_BRIDGE_ROOT=/var/lib/nando-wave/transition/opportunity-bridge-v1
Environment=MIMALLOC_PURGE_DELAY=0
WorkingDirectory=/opt/nando-wave
ExecStart=/opt/nando-wave/bin/nando-transition-serving
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubu/.codex/sessions
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nando-wave/transition
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
