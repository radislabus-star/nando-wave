[Unit]
Description=Nando verifier-bound Rust transition serving worker
After=network.target nando-gateway-control.service
Wants=nando-gateway-control.service

[Service]
Type=simple
User=ubu
Group=ubu
EnvironmentFile=/etc/nando-wave/phase-center.env
Environment=NANDO_TRANSITION_SERVING_BIND=127.0.0.1:18789
Environment=NANDO_GATEWAY_PUBLIC_MODE_JSON=/run/nando-gateway-control/mode.json
Environment=NANDO_LOCAL_ACCEPT_ENABLED=1
Environment=NANDO_CLIENT_ALLOW_LOCAL_ACCEPT=1
Environment=NANDO_GATEWAY_CPU_ROUTE_READY=1
Environment=NANDO_FALLBACK_MANAGED_BY_NGINX=1
WorkingDirectory=/opt/nando-wave
ExecStart=/opt/nando-wave/bin/nando-transition-serving
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
TasksMax=32
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/ubu/.codex/sessions
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/nando-wave/transition
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
