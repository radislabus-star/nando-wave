[Unit]
Description=Nando local gateway control plane
After=network.target

[Service]
Type=simple
User=ubu
Group=ubu
EnvironmentFile=/etc/nando-wave/phase-center.env
EnvironmentFile=/etc/nando-wave/roles/gateway-control.env
EnvironmentFile=-/etc/nando-wave/authority.env
ExecStart=/opt/nando-wave/bin/nando-gateway-control
Restart=always
RestartSec=1s
TimeoutStartSec=10s
TimeoutStopSec=10s
StateDirectory=nando-gateway-control
StateDirectoryMode=0700
RuntimeDirectory=nando-gateway-control
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true
MemoryHigh=64M
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
