# Nando Phase-Center Test Server v1 environment.
# Copy to /etc/nando-wave/phase-center.env and edit paths for the test server.

NANDO_BIN=/opt/nando-wave/bin/nando-cli

NANDO_STATE_DIR=/var/lib/nando-wave/streaming
NANDO_LOG_DIR=/var/log/nando-wave
NANDO_CODEX_SESSIONS_DIR=/home/ubu/.codex/sessions
NANDO_CODEX_CAPTURE_STATE=/var/lib/nando-wave/transition/codex-session-capture.json
NANDO_CODEX_CAPTURE_LOOKBACK_DAYS=2
NANDO_CODEX_CAPTURE_MAX_EVENTS=64
NANDO_CODEX_CAPTURE_MAX_EVENTS_PER_FILE=16
NANDO_CODEX_CAPTURE_GENERIC_RELATION_FILES_PER_CYCLE=16
NANDO_CODEX_CAPTURE_WAIT_RELATION_FILES_PER_CYCLE=16
NANDO_CODEX_CAPTURE_TIMEOUT_SECONDS=0.8

NANDO_WATERMARK_TRACE_JSONL=/var/lib/nando-wave/streaming/real-traffic-phase-atom-trace-v1.jsonl
NANDO_APPEND_JSONL=/var/lib/nando-wave/streaming/live-agent-phase-atom-append-v1.jsonl
NANDO_APPENDER_REPORT=/var/lib/nando-wave/streaming/phase-center-appender.report.json
NANDO_LIVE_TAIL_REPORT=/var/lib/nando-wave/streaming/nando-phase-live-miner-tail.report.json
NANDO_DECISIONS_JSONL=/var/lib/nando-wave/streaming/nando-phase-live-miner-tail.decisions.jsonl
NANDO_PRODUCT_HOT_REGISTRY_JSON=/var/lib/nando-wave/streaming/nando-phase-product-hot-registry.json
NANDO_PHASE_ENABLE_EXTERNAL_PRODUCT_HOT_REGISTRY=0

NANDO_PROVIDER_EXPORT_DROP_DIR=/var/lib/nando-wave/provider-export-drop
NANDO_PROVIDER_EXPORT_JSONL=/var/lib/nando-wave/provider-export-drop/provider-export.external.jsonl
NANDO_PROVIDER_EXPORT_WATCH_REPORT=/var/lib/nando-wave/streaming/provider-export-watch.report.json
NANDO_PROVIDER_EXPORT_WORK_DIR=/var/lib/nando-wave/streaming/provider-export-watch
NANDO_PROVIDER_EXPORT_WATCH_RUNTIME_REPLAY_REPORT=/var/lib/nando-wave/streaming/nando-phase-live-miner-tail.report.json
NANDO_PROVIDER_EXPORT_WATCH_BILLING_REQUEST_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-export-acquisition.report.json
NANDO_PROVIDER_EXPORT_WATCH_BILLING_REQUEST_JSONL=/var/lib/nando-wave/streaming/provider-evidence/provider-export-acquisition-pack/billing-request.jsonl
NANDO_PROVIDER_EXPORT_WATCH_BILLING_CONTRACT_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-export-contract.report.json

NANDO_PROVIDER_EVIDENCE_DIR=/var/lib/nando-wave/streaming/provider-evidence
NANDO_PROVIDER_ACQUISITION_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-export-acquisition.report.json
NANDO_PROVIDER_ACQUISITION_PACK_DIR=/var/lib/nando-wave/streaming/provider-evidence/provider-export-acquisition-pack
NANDO_PROVIDER_EVIDENCE_CHAIN_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-export-evidence-chain.report.json
NANDO_PROVIDER_EVIDENCE_CHAIN_DIR=/var/lib/nando-wave/streaming/provider-evidence/provider-export-evidence-chain
NANDO_PROVIDER_EVIDENCE_SNAPSHOT_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-evidence-snapshot.report.json
NANDO_PROVIDER_EXPORT_CONTRACT_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-export-contract.report.json
NANDO_PROVIDER_EXPORT_CONTRACT_DIR=/var/lib/nando-wave/streaming/provider-evidence/provider-export-contract
NANDO_PROVIDER_BOUNDARY_CAPTURE_COVERAGE_REPORT=/var/lib/nando-wave/streaming/provider-evidence/provider-boundary-capture-coverage.report.json

NANDO_METRICS_DIR=/var/lib/nando-wave/streaming/metrics
NANDO_METRICS_SNAPSHOT_JSON=/var/lib/nando-wave/streaming/metrics/nando-phase-center.metrics.json
NANDO_METRICS_SNAPSHOT_PROM=/var/lib/nando-wave/streaming/metrics/nando-phase-center.prom
NANDO_READINESS_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.readiness.json
NANDO_READINESS_PROM=/var/lib/nando-wave/streaming/metrics/nando-phase-center.readiness.prom
NANDO_VERIFY_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.test-server-verify.json
NANDO_LOCAL_ACCEPT_PROMOTION_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.local-accept-promotion.json
NANDO_LOCAL_ACCEPT_POLICY_CANDIDATE=/var/lib/nando-wave/streaming/metrics/nando-phase-center.local-accept-policy-candidate.json
NANDO_REFRESH_SNAPSHOTS_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.refresh-snapshots.json
NANDO_GATEWAY_CANARY_SMOKE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.gateway-canary-smoke.json
NANDO_PROVIDER_BRIDGE_ACTIVATION_GATE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-activation-gate.json
NANDO_PROVIDER_BRIDGE_ACTIVATE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-activate.json
NANDO_PROVIDER_BRIDGE_ACTIVATE_SMOKE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-activate-smoke.json
NANDO_PROVIDER_BRIDGE_DEACTIVATE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-deactivate.json
NANDO_SYSTEM_CLIENT_ENV_PATH=/etc/profile.d/nando-wave-client.sh
NANDO_PHASE_CENTER_OPS_DIR=/opt/nando-wave/ops/phase-center-test-server
NANDO_SYSTEMD_DIR=/etc/systemd/system

NANDO_CELLS=32
NANDO_MIN_BUCKET_EVENTS=8
NANDO_POLL_MS=1000
NANDO_APPENDER_MAX_IDLE_MS=0
NANDO_APPENDER_MAX_ROWS=0
NANDO_MAX_RECENT_FILES=64
NANDO_IDLE_SLEEP_MS=1000
NANDO_LIVE_TAIL_MAX_IDLE_MS=0
NANDO_MAX_APPEND_EVENTS=0
NANDO_APPEND_COMPRESSION_CLAIM_MIN_ROWS=64
NANDO_PHASE_MINER_SATURATION_MIN_IDLE_HEARTBEATS=3
NANDO_PHASE_MINER_SATURATION_SLEEP_MS=5000
NANDO_PHASE_MINER_ACTIVE_BATCH_ROWS=64
NANDO_PHASE_MINER_ACTIVE_BATCH_SLEEP_MS=5

# Provider export watch is cold path. Keep it bounded.
NANDO_PROVIDER_WATCH_CYCLES=1
NANDO_PROVIDER_WATCH_SLEEP_MS=0
NANDO_PROVIDER_WATCH_MAX_CANDIDATES=8

# Never enable this by editing the env alone. Promotion needs a separate gate.
NANDO_LOCAL_ACCEPT_ENABLED=0

# Shared fail-open gateway for local agents/Codex copies.
# All agents may call:
#   nando-llm-gateway /etc/nando-wave/phase-center.env -- <normal-provider-command>
#
# The gateway records token/request telemetry first, then tries Nando only when
# explicitly enabled. Any timeout, error, verifier miss, or kill-switch sends
# the request to the normal provider command.
NANDO_OFFLOAD=1
NANDO_GATEWAY_TIMEOUT_MS=200
NANDO_GATEWAY_EVENTS_JSONL=/var/lib/nando-wave/streaming/nando-llm-gateway.events.jsonl
NANDO_GATEWAY_DECISIONS_JSONL=/var/lib/nando-wave/streaming/nando-llm-gateway.decisions.jsonl
NANDO_GATEWAY_TMP_DIR=/tmp/nando-wave-gateway
NANDO_GATEWAY_CAPTURE_RAW=0

# OpenAI-compatible HTTP bridge. Local accepts are verifier-bound; broad
# requests proxy to upstream when configured, otherwise return upstream_missing.
NANDO_PROVIDER_BRIDGE_BIND=127.0.0.1:8787
NANDO_PROVIDER_BRIDGE_EVENTS_JSONL=/var/lib/nando-wave/streaming/nando-provider-bridge.events.jsonl
NANDO_PROVIDER_BRIDGE_DECISIONS_JSONL=/var/lib/nando-wave/streaming/nando-provider-bridge.decisions.jsonl
NANDO_PROVIDER_BRIDGE_BOUNDARY_EVENTS_JSONL=/var/lib/nando-wave/streaming/nando-provider-bridge.provider-boundary-events.jsonl
NANDO_PROVIDER_BRIDGE_SMOKE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-bridge-smoke.json
NANDO_PROVIDER_BRIDGE_UPSTREAM_SMOKE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-bridge-upstream-smoke.json
NANDO_PROVIDER_BRIDGE_UPSTREAM_ONBOARD_SMOKE_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-bridge-upstream-onboard-smoke.json
NANDO_PROVIDER_BRIDGE_UPSTREAM_READINESS_REPORT=/var/lib/nando-wave/streaming/metrics/nando-phase-center.provider-bridge-upstream-readiness.json
NANDO_PROVIDER_BRIDGE_LOCAL_TIMEOUT_MS=200
NANDO_PROVIDER_BRIDGE_MAX_BODY_BYTES=1048576
NANDO_PROVIDER_BRIDGE_METRICS_WINDOW=1000

# Autonomous typed-transition lifecycle. Thresholds are compiled into the
# versioned zero-error policy; the only manual runtime control is the global
# NANDO_CLIENT_KILL_SWITCH below.
NANDO_TRANSITION_STATE_DIR=/var/lib/nando-wave/transition
NANDO_TRANSITION_TRACE_JSONL=/var/lib/nando-wave/transition/live-transitions.jsonl
NANDO_LEGACY_JSON_AUDIT_ENABLED=0
NANDO_TRANSITION_PACKAGE_INBOX=/var/lib/nando-wave/transition/package-inbox
NANDO_TRANSITION_REGISTRY=/var/lib/nando-wave/transition/registry.json
NANDO_TRANSITION_METRICS=/var/lib/nando-wave/transition/metrics.json
# Emergency compatibility fallback only. New autonomous induction uses raw phase.
NANDO_TRANSITION_LEGACY_NAMED_INDUCER=0
NANDO_TRANSITION_EXECUTOR=/opt/nando-wave/bin/nando-transition-live-exec
NANDO_TRANSITION_ADMISSION_JSON=/var/lib/nando-wave/transition/admission.json
NANDO_TRANSITION_ADMISSION_MAX_AGE_SECONDS=30
# Generic Rust self-training from completed teacher actions. Runtime routing
# remains pre-action-only; old named/template miners stay independently off.
NANDO_EMBEDDED_RESPONSE_MINER_ENABLED=1
NANDO_GENERIC_RESPONSE_MINER_ENABLED=1
NANDO_LEGACY_RESPONSE_MINER_ENABLED=0
NANDO_RESPONSE_ONLINE_CHECKPOINT=/var/lib/nando-wave/transition/response-online-miner.checkpoint
NANDO_STREAMING_EVIDENCE_DIR=/var/lib/nando-wave/transition/streaming-evidence-v2
NANDO_ECONOMICS_SNAPSHOT_JSON=/var/lib/nando-wave/transition/economics-live.json
NANDO_ALLOW_UPSTREAM_SELF_REPORTED_TRANSITIONS=0
NANDO_STATUS_DASHBOARD_KEY=
NANDO_STATUS_DASHBOARD_HISTORY_JSONL=/var/lib/nando-wave/streaming/metrics/nando-phase-center.dashboard-history.jsonl
NANDO_STATUS_DASHBOARD_HISTORY_MAX_POINTS=360
NANDO_STATUS_DASHBOARD_HISTORY_MIN_INTERVAL_SECONDS=10
NANDO_PROVIDER_NAME=openai_compatible_upstream
NANDO_PROVIDER_UPSTREAM_BASE_URL=
# Optional. Leave empty for Codex/client forwarded Authorization.
NANDO_PROVIDER_UPSTREAM_API_KEY=
NANDO_PROVIDER_BRIDGE_UPSTREAM_READINESS_ALLOW_REAL_CALL=0
NANDO_PROVIDER_BRIDGE_UPSTREAM_READINESS_PROMPT='ordinary broad prompt'

# Server-side client safety controls.
# Keep defaults conservative; change only through reviewed server policy.
NANDO_CLIENT_SAFETY_POLICY=shadow_only
NANDO_CLIENT_ID=default
NANDO_CLIENT_TIER=shadow
NANDO_CLIENT_ALLOW_LOCAL_ACCEPT=0
NANDO_CLIENT_MAX_TIMEOUT_MS=200
NANDO_CLIENT_REQUIRE_VERIFIER=1
NANDO_CLIENT_REQUIRE_FALSE_ACCEPTS_ZERO=1
NANDO_CLIENT_KILL_SWITCH=0

# Optional local command. It must read the request from stdin and emit JSON:
#   {"local_accept":true,"verifier_ok":true,"response":"..."}
# Server deployment should point this to the reviewed executor under /opt.
# The boxed executor only accepts exact verifier-bound routes such as:
#   nando health, nando status, nando compression, nando readiness,
#   nando promotion, nando server
# Any broad prompt must decline so the gateway falls back to the provider.
NANDO_GATEWAY_LOCAL_CMD=/opt/nando-wave/ops/phase-center-test-server/bin/nando-llm-local-executor.sh
