#!/usr/bin/env bash
set -euo pipefail

REAL_CODEX="${NANDO_REAL_CODEX:-/home/ubu/.nvm/versions/node/v22.22.2/lib/node_modules/@openai/codex/bin/codex.js}"
EVENTS_JSONL="${NANDO_GATEWAY_EVENTS_JSONL:-${HOME}/.local/state/nando-wave/streaming/nando-codex-launcher.events.jsonl}"
HEALTH_URL="${NANDO_CODEX_HEALTH_URL:-http://127.0.0.1:8787/health}"
HEALTH_TIMEOUT_SECONDS="${NANDO_CODEX_HEALTH_TIMEOUT_SECONDS:-0.5}"
MODEL_PROVIDER="${NANDO_CODEX_MODEL_PROVIDER:-nando_nginx}"
SELECTED_BASE_URL="http://127.0.0.1:8787/v2"
MODEL_PROVIDER_OVERRIDE="model_provider=\"${MODEL_PROVIDER}\""

route_mode="direct_fallback"
route_reason="gateway_not_checked"
health_ok=false
health_service="unknown"
transport="unknown"
config_override_scope="none"
config_override_insert_index=-1
config_override_position_verified=false
CODEX_ARGS=("$@")

is_config_value_option() {
  case "$1" in
    -c|--config|-i|--image|-m|--model|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval|--remote|--remote-auth-token-env)
      return 0
      ;;
  esac
  return 1
}

is_codex_subcommand() {
  case "$1" in
    exec|review|login|logout|mcp|plugin|mcp-server|app-server|remote-control|completion|update|doctor|sandbox|debug|apply|resume|archive|delete|unarchive|fork|cloud|exec-server|features|help)
      return 0
      ;;
  esac
  return 1
}

is_model_subcommand() {
  case "$1" in
    exec|review|resume|fork)
      return 0
      ;;
  esac
  return 1
}

build_nando_codex_args() {
  local -a original=("$@")
  local expect_value=0
  local index token insert_at

  for index in "${!original[@]}"; do
    token="${original[$index]}"
    if (( expect_value )); then
      expect_value=0
      continue
    fi
    if is_config_value_option "${token}"; then
      expect_value=1
      continue
    fi
    case "${token}" in
      --*=*|-*)
        continue
        ;;
    esac
    if is_codex_subcommand "${token}"; then
      if is_model_subcommand "${token}"; then
        insert_at=$((index + 1))
        CODEX_ARGS=(
          "${original[@]:0:${insert_at}}"
          -c "${MODEL_PROVIDER_OVERRIDE}"
          "${original[@]:${insert_at}}"
        )
        config_override_scope="${token}"
        config_override_insert_index="${insert_at}"
        config_override_position_verified=true
      else
        CODEX_ARGS=("${original[@]}")
        config_override_scope="utility:${token}"
      fi
      return
    fi

    # The first positional value is an interactive prompt.
    break
  done

  CODEX_ARGS=(-c "${MODEL_PROVIDER_OVERRIDE}" "${original[@]}")
  config_override_scope="interactive"
  config_override_insert_index=0
  config_override_position_verified=true
}

sanitize_direct_env() {
  case "${OPENAI_BASE_URL:-}" in
    http://127.0.0.1:8787/*|http://127.0.0.1:18787/*) unset OPENAI_BASE_URL ;;
  esac
  case "${OPENAI_API_BASE:-}" in
    http://127.0.0.1:8787/*|http://127.0.0.1:18787/*) unset OPENAI_API_BASE ;;
  esac
  if [[ "${OPENAI_API_KEY:-}" == "nando-local" ]]; then
    unset OPENAI_API_KEY
  fi
}

gateway_requested() {
  [[ "${NANDO_CODEX_FORCE_DIRECT:-0}" != "1" ]] || { route_reason="forced_direct"; return 1; }
  [[ "${NANDO_CODEX_ALIAS:-1}" != "0" ]] || { route_reason="alias_bypass"; return 1; }
  [[ "${NANDO_CODEX_GATEWAY:-1}" != "0" ]] || { route_reason="gateway_bypass"; return 1; }
  [[ "${NANDO_OFFLOAD:-1}" != "0" ]] || { route_reason="offload_disabled"; return 1; }
}

gateway_healthy() {
  local body
  body="$(curl --silent --show-error --fail \
    --connect-timeout "${HEALTH_TIMEOUT_SECONDS}" \
    --max-time "${HEALTH_TIMEOUT_SECONDS}" \
    "${HEALTH_URL}" 2>/dev/null || true)"
  if [[ -z "${body}" ]]; then
    route_reason="health_timeout_or_down"
    return 1
  fi

  health_ok="$(jq -r '(.ok // false) | tostring' <<<"${body}" 2>/dev/null || echo false)"
  health_service="$(jq -r '.service // "unknown"' <<<"${body}" 2>/dev/null || echo unknown)"
  transport="$(jq -r '.transport // "unknown"' <<<"${body}" 2>/dev/null || echo unknown)"
  if [[ "${health_ok}" != "true" || "${health_service}" != "nando-nginx-gateway" || "${transport}" != "nginx" ]]; then
    route_reason="unexpected_health_contract"
    return 1
  fi

  route_mode="nando_nginx"
  route_reason="nginx_transport_healthy"
  return 0
}

if gateway_requested && gateway_healthy; then
  build_nando_codex_args "$@"
else
  sanitize_direct_env
  MODEL_PROVIDER_OVERRIDE='model_provider="openai"'
  build_nando_codex_args "$@"
fi

mkdir -p "$(dirname "${EVENTS_JSONL}")" 2>/dev/null || true
jq -cn \
  --arg timestamp "$(date -Is)" \
  --arg cwd "${PWD}" \
  --arg route_mode "${route_mode}" \
  --arg route_reason "${route_reason}" \
  --arg health_service "${health_service}" \
  --arg transport "${transport}" \
  --arg selected_model_provider "$(if [[ "${route_mode}" == "nando_nginx" ]]; then printf '%s' "${MODEL_PROVIDER}"; else printf 'openai'; fi)" \
  --arg selected_base_url "$(if [[ "${route_mode}" == "nando_nginx" ]]; then printf '%s' "${SELECTED_BASE_URL}"; fi)" \
  --arg config_override_scope "${config_override_scope}" \
  --argjson config_override_insert_index "${config_override_insert_index}" \
  --argjson config_override_position_verified "${config_override_position_verified}" \
  --argjson health_ok "${health_ok}" \
  '{
    schema: "nando_codex_launcher_event_v2",
    timestamp: $timestamp,
    cwd: $cwd,
    route_mode: $route_mode,
    route_reason: $route_reason,
    health_service: $health_service,
    transport: $transport,
    selected_model_provider: $selected_model_provider,
    selected_base_url: $selected_base_url,
    config_override_scope: $config_override_scope,
    config_override_insert_index: $config_override_insert_index,
    config_override_position_verified: $config_override_position_verified,
    health_ok: $health_ok,
    python_transport: false,
    local_accept_decision: "not_in_launcher",
    boundary: "healthy local Nginx transport or direct official Codex"
  }' >>"${EVENTS_JSONL}" 2>/dev/null || true

if [[ "${NANDO_CODEX_DRY_RUN:-0}" == "1" ]]; then
  jq -n \
    --arg route_mode "${route_mode}" \
    --arg route_reason "${route_reason}" \
    --arg health_service "${health_service}" \
    --arg transport "${transport}" \
    --arg selected_model_provider "$(if [[ "${route_mode}" == "nando_nginx" ]]; then printf '%s' "${MODEL_PROVIDER}"; else printf 'openai'; fi)" \
    --arg selected_base_url "$(if [[ "${route_mode}" == "nando_nginx" ]]; then printf '%s' "${SELECTED_BASE_URL}"; fi)" \
    --arg config_override_scope "${config_override_scope}" \
    --argjson config_override_insert_index "${config_override_insert_index}" \
    --argjson config_override_position_verified "${config_override_position_verified}" \
    --argjson health_ok "${health_ok}" \
    '{
      route_mode: $route_mode,
      route_reason: $route_reason,
      health_service: $health_service,
      transport: $transport,
      selected_model_provider: $selected_model_provider,
      selected_base_url: $selected_base_url,
      config_override_scope: $config_override_scope,
      config_override_insert_index: $config_override_insert_index,
      config_override_position_verified: $config_override_position_verified,
      health_ok: $health_ok
    }'
  exit 0
fi

if [[ "${route_mode}" == "nando_nginx" ]]; then
  exec node "${REAL_CODEX}" "${CODEX_ARGS[@]}"
fi

exec node "${REAL_CODEX}" "${CODEX_ARGS[@]}"
