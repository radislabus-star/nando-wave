#!/usr/bin/env bash
set -euo pipefail

SERVER_ORIGIN="${NANDO_SERVER_ORIGIN:-http://192.168.3.94:8787}"
CONNECTOR_ORIGIN="${NANDO_CONNECTOR_ORIGIN:-http://127.0.0.1:8787}"
BASE_URL="${NANDO_CONNECTOR_BASE_URL:-${CONNECTOR_ORIGIN%/}/v1}"
HEALTH_URL="${NANDO_CONNECTOR_HEALTH_URL:-${CONNECTOR_ORIGIN%/}/health}"
REMOTE_HEALTH_URL="${NANDO_REMOTE_HEALTH_URL:-${SERVER_ORIGIN%/}/health}"
REMOTE_CPU_HEALTH_URL="${NANDO_REMOTE_CPU_HEALTH_URL:-${SERVER_ORIGIN%/}/cpu-health}"
METRICS_URL="${NANDO_CONNECTOR_METRICS_URL:-http://127.0.0.1:18786/metrics}"
SERVICE="${NANDO_CONNECTOR_SERVICE:-nando-client-connector.service}"
SYSTEMCTL="${NANDO_CONNECT_SYSTEMCTL_BIN:-systemctl}"
LEGACY_SHIM_SERVICE="${NANDO_LEGACY_SHIM_SERVICE:-nando-transport-gateway.service}"
LEGACY_SHIM_UNIT="${NANDO_LEGACY_SHIM_UNIT:-/etc/systemd/system/nando-transport-gateway.service}"
LEGACY_SHIM_DROPIN_DIR="${NANDO_LEGACY_SHIM_DROPIN_DIR:-/etc/systemd/system/nando-transport-gateway.service.d}"
LEGACY_SHIM_DROPIN="${NANDO_LEGACY_SHIM_DROPIN:-${LEGACY_SHIM_DROPIN_DIR}/client-only.conf}"
COMPATIBILITY_DROPIN="${NANDO_CONNECTOR_COMPATIBILITY_DROPIN:-${HOME}/.config/systemd/user/nando-client-connector.service.d/compatibility.conf}"

usage() {
  printf '%s\n' \
    "Usage:" \
    "  nando-connect                  Start if needed and show live status" \
    "  nando-connect status           Show status once" \
    "  nando-connect start|stop" \
    "  nando-connect health" \
    "  nando-connect url" \
    "  nando-connect server-url" \
    "  nando-connect env" \
    "" \
    "Run Codex separately with: codex"
}

fetch() {
  curl --silent --show-error --fail \
    --connect-timeout "${NANDO_CONNECT_TIMEOUT_SECONDS:-2}" \
    --max-time "${NANDO_CONNECT_TIMEOUT_SECONDS:-2}" \
    "$1"
}

check_transport() {
  local body
  body="$(fetch "${HEALTH_URL}")"
  case "${body}" in
    *'"ok":true'*'"service":"nando-nginx-gateway"'*'"transport":"nginx"'*)
      ;;
    *)
      printf 'Unexpected Nando health contract from %s\n' "${HEALTH_URL}" >&2
      return 1
      ;;
  esac
  printf '%s\n' "${body}"
}

service_state() {
  "${SYSTEMCTL}" --user is-active "${SERVICE}" 2>/dev/null || true
}

start_connector() {
  "${SYSTEMCTL}" --user start "${SERVICE}"
}

migrate_legacy_shim() {
  [[ "${NANDO_CONNECT_SKIP_LEGACY_MIGRATION:-0}" != "1" ]] || return 0
  [[ -e "${COMPATIBILITY_DROPIN}" ]] || return 0

  printf 'Removing legacy local Nginx shim; connector will listen directly on 127.0.0.1:8787.\n'
  sudo systemctl disable --now "${LEGACY_SHIM_SERVICE}"
  unlink "${COMPATIBILITY_DROPIN}"
  rmdir "$(dirname "${COMPATIBILITY_DROPIN}")"
  "${SYSTEMCTL}" --user daemon-reload

  if [[ -e "${LEGACY_SHIM_DROPIN}" ]]; then
    sudo unlink "${LEGACY_SHIM_DROPIN}"
  fi
  if [[ -d "${LEGACY_SHIM_DROPIN_DIR}" ]]; then
    sudo rmdir "${LEGACY_SHIM_DROPIN_DIR}"
  fi
  if [[ -e "${LEGACY_SHIM_UNIT}" ]]; then
    sudo unlink "${LEGACY_SHIM_UNIT}"
  fi
  sudo systemctl daemon-reload
}

render_status() {
  local state transport cpu metrics
  state="$(service_state)"
  transport="$(fetch "${REMOTE_HEALTH_URL}" 2>/dev/null || true)"
  cpu="$(fetch "${REMOTE_CPU_HEALTH_URL}" 2>/dev/null || true)"
  metrics="$(fetch "${METRICS_URL}" 2>/dev/null || true)"

  printf 'NANDO CONNECT\n'
  printf 'LOCAL CONNECTOR  %s\n' "${state:-unknown}"
  printf 'ROUTE            %s -> %s\n' "${BASE_URL}" "${SERVER_ORIGIN%/}/v1"

  if [[ -z "${transport}" || -z "${cpu}" ]] || ! command -v jq >/dev/null 2>&1; then
    printf 'REMOTE           %s\n' "$([[ -n "${transport}" ]] && printf ONLINE || printf UNAVAILABLE)"
    return
  fi

  jq -r '
    "REMOTE           " + (if .ok then "ONLINE" else "UNAVAILABLE" end),
    "CPU / ADMISSION  " + (.mode // "?") + " / " + (.admission_verdict // "?"),
    "ACTIVE PROFILES  " + ((.response_active_profiles // 0) | tostring),
    "ORDINARY ACCEPTS " + ((.ordinary_response_local_accepts // 0) | tostring),
    "CPU INPUT TOKENS " + ((.ordinary_response_local_accept_input_tokens // 0) | tostring),
    "REQUESTS         " + ((.requests // 0) | tostring),
    "UPSTREAM FALLBACK " + ((.fallbacks // 0) | tostring),
    "FALSE ACCEPTS    " + ((.transition_false_accepts // 0) | tostring)
  ' <<<"${cpu}"

  if [[ -n "${metrics}" ]]; then
    printf '\nCONNECTOR TRAFFIC\n'
    jq -r '
      "ACTIVE CONNECTIONS " + ((.active_connections // 0) | tostring),
      "CONNECTIONS TOTAL  " + ((.accepted_connections // 0) | tostring),
      "CONNECTIONS DONE   " + ((.completed_connections // 0) | tostring),
      "UPLOAD BYTES       " + ((.upload_bytes // 0) | tostring),
      "DOWNLOAD BYTES     " + ((.download_bytes // 0) | tostring),
      "RELAY FAILURES     " + ((.relay_failures // 0) | tostring),
      "HTTP REQUESTS      " + ((.http_requests // 0) | tostring),
      "NANDO RESPONSES    " + ((.nando_responses // 0) | tostring),
      "CLIENT FALLBACKS   " + ((.client_fallback_successes // 0) | tostring)
        + " / " + ((.client_fallback_attempts // 0) | tostring),
      "FALLBACK FAILURES  " + ((.client_fallback_failures // 0) | tostring),
      "ABSTAIN REPLAYS    " + ((.abstain_fallbacks // 0) | tostring),
      "REMOTE FAILOVER    " + ((.remote_failure_fallbacks // 0) | tostring),
      "REPLAY SPILLS      " + ((.replay_spills // 0) | tostring),
      "UPTIME SECONDS     " + ((.uptime_seconds // 0) | tostring)
    ' <<<"${metrics}"
  else
    printf '\nCONNECTOR TRAFFIC unavailable; rerun nando-connect after active Codex streams finish.\n'
  fi
}

watch_status() {
  if [[ "${1:-start}" == "start" ]]; then
    start_connector
  fi
  while :; do
    if [[ -t 1 ]]; then
      printf '\033[2J\033[H'
    fi
    render_status
    printf '\nCtrl+C closes this monitor; the connector keeps running.\n'
    [[ "${NANDO_CONNECT_WATCH_ONCE:-0}" == "1" ]] && return
    sleep "${NANDO_CONNECT_REFRESH_SECONDS:-2}"
  done
}

command_name="${1:-console}"
case "${command_name}" in
  console)
    migrate_legacy_shim
    start_connector
    watch_status already-started
    ;;
  watch)
    watch_status
    ;;
  status)
    render_status
    ;;
  start)
    start_connector
    render_status
    ;;
  stop)
    "${SYSTEMCTL}" --user stop "${SERVICE}"
    printf 'Nando connector stopped.\n'
    ;;
  restart)
    "${SYSTEMCTL}" --user restart "${SERVICE}"
    watch_status already-started
    ;;
  health)
    check_transport
    ;;
  url)
    printf '%s\n' "${BASE_URL}"
    ;;
  server-url)
    printf '%s\n' "${SERVER_ORIGIN%/}/v1"
    ;;
  env)
    printf 'export OPENAI_BASE_URL=%q\n' "${BASE_URL}"
    printf 'export OPENAI_API_BASE=%q\n' "${BASE_URL}"
    ;;
  codex)
    printf 'nando-connect no longer launches Codex; run: codex\n' >&2
    exit 2
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
