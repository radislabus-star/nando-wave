[Unit]
Description=Refresh Nando authority lease when the response registry changes
After=nando-response-admission.service

[Path]
PathChanged=/var/lib/nando-wave/transition/response-registry.json
PathChanged=/var/lib/nando-wave/transition/response-authority-candidate.json
Unit=nando-live-transition-gate.service

[Install]
WantedBy=multi-user.target
