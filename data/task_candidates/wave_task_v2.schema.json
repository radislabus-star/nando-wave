{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nando-wave.local/schemas/wave_task_v2.schema.json",
  "title": "Wave Task V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "language",
    "task_kind",
    "domain_path",
    "domain_tags",
    "source_family",
    "source_group",
    "input",
    "target",
    "near_negative",
    "operator_family",
    "why_target_is_correct",
    "why_negative_is_wrong",
    "shortcut_risk",
    "quality_status"
  ],
  "properties": {
    "schema_version": {
      "const": "wave_task_v2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "task_kind": {
      "type": "string",
      "minLength": 1
    },
    "domain_path": {
      "type": "string",
      "minLength": 3
    },
    "domain_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "source_group": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "near_negative": {
      "type": "string",
      "minLength": 1
    },
    "operator_family": {
      "type": "string",
      "minLength": 1
    },
    "why_target_is_correct": {
      "type": "string",
      "minLength": 1
    },
    "why_negative_is_wrong": {
      "type": "string",
      "minLength": 1
    },
    "shortcut_risk": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "quality_status": {
      "enum": [
        "candidate",
        "reference",
        "accepted",
        "rejected"
      ]
    }
  }
}
