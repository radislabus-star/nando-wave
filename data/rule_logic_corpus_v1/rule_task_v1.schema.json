{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nando-wave.local/schemas/rule_task_v1.schema.json",
  "title": "Rule Logic Task V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "language",
    "surface_family",
    "source_group",
    "input",
    "target",
    "near_negative",
    "answer_status",
    "proof_rule_id",
    "proof_rule_family",
    "why_target_is_correct",
    "why_negative_is_wrong",
    "shortcut_risk",
    "quality_status"
  ],
  "properties": {
    "schema_version": {"const": "rule_task_v1"},
    "task_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "surface_family": {"type": "string", "minLength": 1},
    "source_group": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "near_negative": {"type": "string", "minLength": 1},
    "answer_status": {"enum": ["PROVEN", "LIKELY", "UNSETTLED", "CONFLICT"]},
    "proof_rule_id": {"type": "string", "minLength": 1},
    "proof_rule_family": {"type": "string", "minLength": 1},
    "why_target_is_correct": {"type": "string", "minLength": 1},
    "why_negative_is_wrong": {"type": "string", "minLength": 1},
    "shortcut_risk": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "quality_status": {"enum": ["candidate", "accepted", "rejected"]}
  }
}
